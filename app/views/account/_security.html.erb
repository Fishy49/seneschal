<%= render layout: "shared/components/card", locals: { title: "Security", class: "mb-4" } do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-sm font-medium">
        Two-factor authentication
        <% if current_user.otp_required_for_login? %>
          <span class="ml-2 text-xs text-success">enabled</span>
        <% else %>
          <span class="ml-2 text-xs text-content-muted">not set</span>
        <% end %>
      </div>
      <p class="text-xs text-content-muted mt-1">
        <% if current_user.otp_required_for_login? %>
          Signing in asks for a code from your authenticator app.
        <% else %>
          Add a code from an authenticator app on top of your password.
        <% end %>
      </p>
    </div>
    <% if current_user.otp_required_for_login? %>
      <%= button_to "Disable", disable_two_factor_path, method: :post,
            class: btn_classes(:ghost, size: :sm, extra: "shrink-0 hover:text-danger"),
            data: { turbo_confirm: "Disable two-factor authentication?" } %>
    <% else %>
      <%= link_to "Enable two-factor authentication", setup_two_factor_path,
            class: btn_classes(:ghost, size: :sm, extra: "shrink-0") %>
    <% end %>
  </div>
<% end %>
