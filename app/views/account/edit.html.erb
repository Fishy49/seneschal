<%= render "shared/components/page_header", title: "Account" %>

<%= render layout: "shared/components/card", locals: { title: "Profile" } do %>
  <%= form_with model: current_user, url: account_path, method: :patch, class: "space-y-4 max-w-md" do |f| %>
    <% if current_user.errors.any? %>
      <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg text-sm">
        <% current_user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :email, class: label_classes %>
      <%= f.email_field :email, required: true, class: input_classes %>
    </div>

    <div>
      <%= f.label :password, "New Password", class: label_classes %>
      <%= f.password_field :password, class: input_classes %>
      <p class="<%= hint_classes %>">Leave blank to keep current password.</p>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm Password", class: label_classes %>
      <%= f.password_field :password_confirmation, class: input_classes %>
    </div>

    <button type="submit" class="<%= btn_classes(:primary) %>">
      Save Changes
    </button>
  <% end %>
<% end %>

<%= render "account/appearance" %>
<%= render "account/connections" %>
<%= render "account/security" %>
