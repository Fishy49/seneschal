<%= render "shared/library_nav" %>

<%= render layout: "shared/components/page_header", locals: { title: "JSON Schemas" } do %>
  <%= link_to "New Schema", new_json_schema_path, class: btn_classes(:primary) %>
<% end %>

<% if @schemas.any? %>
  <%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="<%= th_classes %>">Name</th>
            <th class="<%= th_classes %>">Description</th>
            <th class="<%= th_classes %>">Used by</th>
          </tr>
        </thead>
        <tbody>
          <% @schemas.each do |schema| %>
            <tr>
              <td class="<%= td_classes %>"><%= link_to schema.name, json_schema_path(schema) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= truncate(schema.description, length: 80) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= schema_usage_label(@usage_counts[schema.id].to_i, @skill_usage_counts[schema.id].to_i) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No output schemas yet. A schema makes a step answer in a fixed shape, so later steps can read individual fields.",
          cta_label: "Create a schema", cta_path: new_json_schema_path %>
  <% end %>
<% end %>
