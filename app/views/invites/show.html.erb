<h2 class="text-xl font-semibold text-center mb-6">Set Up Your Account</h2>
<p class="text-sm text-content-muted text-center mb-6">
  Welcome! Set a password for <strong class="text-content"><%= @user.email %></strong>.
</p>

<%= form_with model: @user, url: accept_invite_path(token: @user.invite_token), method: :patch, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg text-sm">
      <% @user.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :password, class: label_classes %>
    <%= f.password_field :password, autofocus: true, required: true, class: input_classes %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm Password", class: label_classes %>
    <%= f.password_field :password_confirmation, required: true, class: input_classes %>
  </div>

  <button type="submit" class="<%= btn_classes(:primary, extra: "w-full") %>">
    Set Password &amp; Sign In
  </button>
<% end %>
