<p class="text-sm text-content-muted mb-1"><%= link_to "Project Groups", project_groups_path, class: "hover:text-content" %></p>
<%= render layout: "shared/components/page_header", locals: { title: @group.name } do %>
  <%= link_to "Edit", edit_project_group_path(@group), class: btn_classes(:ghost, size: :sm) %>
<% end %>

<% if @group.description.present? %>
  <p class="text-content-muted mb-4"><%= @group.description %></p>
<% end %>

<%= render layout: "shared/components/card", locals: { title: "Projects", class: "mb-4" } do %>
  <% if @projects.any? %>
    <ul class="space-y-1">
      <% @projects.each do |project| %>
        <li class="text-sm py-[var(--row-y)]"><%= link_to project.name, project_path(project) %></li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/components/empty_state", message: "No projects in this group." %>
  <% end %>
<% end %>
