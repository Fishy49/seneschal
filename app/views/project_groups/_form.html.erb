<%= form_with model: @group do |f| %>
  <% if @group.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg mb-4 text-sm">
      <% @group.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: label_classes %>
    <%= f.text_field :name, placeholder: "Frontend", class: input_classes %>
  </div>

  <div class="mb-4">
    <%= f.label :description, class: label_classes %>
    <%= f.text_area :description, placeholder: "Optional description", class: input_classes("resize-y min-h-20") %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: btn_classes(:primary) %>
    <%= link_to "Cancel", project_groups_path, class: btn_classes(:ghost) %>
  </div>
<% end %>
