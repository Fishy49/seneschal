<%= render "shared/admin_nav" %>

<%= render layout: "shared/components/page_header", locals: { title: "Project Groups" } do %>
  <%= link_to "New Group", new_project_group_path, class: btn_classes(:primary) %>
<% end %>

<% if @groups.any? %>
  <% @groups.each do |group| %>
    <%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
      <div class="flex items-center justify-between">
        <div class="flex-1">
          <h3 class="text-base font-semibold"><%= link_to group.name, project_group_path(group) %></h3>
          <% if group.description.present? %>
            <p class="text-sm text-content-muted mt-1"><%= group.description %></p>
          <% end %>
          <div class="text-xs text-content-muted mt-2">
            <%= pluralize(group.projects.size, "project") %>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_project_group_path(group), class: btn_classes(:ghost, size: :sm) %>
          <%= button_to "Delete", project_group_path(group),
                method: :delete,
                class: btn_classes(:ghost, size: :sm, extra: "hover:text-danger"),
                data: { turbo_confirm: "Delete group '#{group.name}'? Projects will be ungrouped." } %>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No groups yet. Groups tidy the project list in the sidebar once you have a few.",
          cta_label: "Create a group", cta_path: new_project_group_path %>
  <% end %>
<% end %>
