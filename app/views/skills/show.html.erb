<%= render layout: "shared/components/page_header",
      locals: { title: @skill.name, subtitle: @skill.shared? ? "Shared" : @skill.project.name } do %>
  <%= link_to "Edit", edit_skill_path(@skill), class: btn_classes(:ghost, size: :sm) %>
  <%= button_to "Delete", skill_path(@skill), method: :delete,
        class: btn_classes(:danger, size: :sm),
        data: { turbo_confirm: "Delete skill '#{@skill.name}'?" } %>
<% end %>

<% if @skill.filesystem_backed? && @skill.absolute_path %>
  <div class="mb-4 p-4 border border-edge rounded-lg bg-surface-muted/40">
    <div class="flex items-start gap-2 mb-2"
         title="A step resolves a skill by name in this order: the project's .claude/skills, then its .seneschal/skills, then the shared folders, then synced skill repositories by priority.">
      <span class="text-sm font-medium text-content-muted">Resolves from:</span>
      <span class="text-sm text-content"><%= skill_source_label(@skill) %></span>
    </div>
    <div class="flex items-start gap-2 mb-2">
      <span class="text-sm font-medium text-content-muted">On disk:</span>
      <code class="text-xs text-content font-mono break-all"><%= @skill.absolute_path %></code>
    </div>
    <p class="text-xs text-content-muted">
      Edit <code>SKILL.md</code> here or on disk to change the body, frontmatter, or <code>allowed-tools</code>.
      Drop helper files into <code>scripts/</code> (executable utilities that run without consuming context)
      or <code>references/</code> (lazy-loaded docs the agent can read on demand).
      Reloading this page re-syncs cached frontmatter from disk.
    </p>
  </div>
<% end %>

<% if @skill.description.present? %>
  <p class="text-content-muted mb-4"><%= @skill.description %></p>
<% end %>

<% if @skill.filesystem_backed? && @skill.frontmatter.any? %>
  <%= render layout: "shared/components/card", locals: { title: "Frontmatter", class: "mb-4" } do %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <tbody>
          <% @skill.frontmatter.each do |key, value| %>
            <tr>
              <th class="<%= td_classes("text-left font-normal align-top w-40") %>"><code class="text-xs font-mono text-content-muted"><%= key %></code></th>
              <td class="<%= td_classes %>">
                <% if value.is_a?(Array) %>
                  <code class="text-xs font-mono"><%= value.join(", ") %></code>
                <% else %>
                  <code class="text-xs font-mono whitespace-pre-wrap"><%= value %></code>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<%= render layout: "shared/components/card", locals: { title: "Prompt body", class: "mb-4" } do %>
  <div data-controller="markdown">
    <div class="code-preview" data-markdown-target="output"></div>
    <template data-markdown-target="source"><%= @skill.body %></template>
  </div>
<% end %>

<% scripts = @skill.scripts_files %>
<% references = @skill.references_files %>

<% if scripts.any? %>
  <% scripts_title = capture do %>
    <code class="text-base font-mono">scripts/</code>
    <span class="text-xs font-normal text-content-muted ml-2">deterministic helpers - run without consuming context</span>
  <% end %>
  <%= render layout: "shared/components/card", locals: { title: scripts_title, class: "mb-4" } do %>
    <%= render "aux_files", kind: "scripts", files: scripts, base: @skill.scripts_dir %>
  <% end %>
<% end %>

<% if references.any? %>
  <% references_title = capture do %>
    <code class="text-base font-mono">references/</code>
    <span class="text-xs font-normal text-content-muted ml-2">lazy-loaded docs the agent can read on demand</span>
  <% end %>
  <%= render layout: "shared/components/card", locals: { title: references_title, class: "mb-4" } do %>
    <%= render "aux_files", kind: "references", files: references, base: @skill.references_dir %>
  <% end %>
<% end %>

<% if @skill.steps.any? %>
  <%= render layout: "shared/components/card", locals: { title: "Used in Steps", class: "mb-4" } do %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="<%= th_classes %>">Step</th>
            <th class="<%= th_classes %>">Workflow</th>
            <th class="<%= th_classes %>">Project</th>
          </tr>
        </thead>
        <tbody>
          <% @skill.steps.includes(workflow: :project).each do |step| %>
            <tr>
              <td class="<%= td_classes %>"><%= step.name %></td>
              <td class="<%= td_classes %>"><%= link_to step.workflow.name, project_workflow_path(step.workflow.project, step.workflow) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= step.workflow.project.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
