<%= render "shared/library_nav" %>

<%= render layout: "shared/components/page_header", locals: { title: "Skills" } do %>
  <%= link_to "New Skill", new_skill_path, class: btn_classes(:primary) %>
<% end %>

<% shared, project_specific = @skills.partition(&:shared?) %>

<% if shared.any? %>
  <%= render layout: "shared/components/card", locals: { title: "Shared", class: "mb-4" } do %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="<%= th_classes %>">Name</th>
            <th class="<%= th_classes %>">Description</th>
            <th class="<%= th_classes %>">Used by</th>
          </tr>
        </thead>
        <tbody>
          <% shared.each do |skill| %>
            <tr>
              <td class="<%= td_classes %>"><%= link_to skill.name, skill_path(skill) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= truncate(skill.description, length: 80) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= pluralize(skill.steps.count, "step") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<% if project_specific.any? %>
  <% project_specific.group_by(&:project).each do |project, skills| %>
    <%= render layout: "shared/components/card", locals: { title: project.name, class: "mb-4" } do %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="<%= th_classes %>">Name</th>
              <th class="<%= th_classes %>">Description</th>
              <th class="<%= th_classes %>">Used by</th>
            </tr>
          </thead>
          <tbody>
            <% skills.each do |skill| %>
              <tr>
                <td class="<%= td_classes %>"><%= link_to skill.name, skill_path(skill) %></td>
                <td class="<%= td_classes("text-content-muted") %>"><%= truncate(skill.description, length: 80) %></td>
                <td class="<%= td_classes("text-content-muted") %>"><%= pluralize(skill.steps.count, "step") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @skills.empty? %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No skills yet. A skill is a reusable SKILL.md an agent step runs; starting a workflow from a template creates a few.",
          cta_label: "Create a skill", cta_path: new_skill_path %>
  <% end %>
<% end %>
