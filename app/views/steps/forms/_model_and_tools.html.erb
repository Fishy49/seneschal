<%# Model settings shared by skill and prompt steps. Locals: step: %>
<% cfg = step.config || {} %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <label for="skill_model" class="block text-sm font-medium text-content-muted mb-1.5">Model</label>
    <select name="skill_model" id="skill_model"
            class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
      <option value="">Default</option>
      <% StepsHelper::MODEL_OPTIONS.each do |label, value| %>
        <option value="<%= value %>" <%= "selected" if cfg["model"] == value %>><%= label %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label for="skill_effort" class="block text-sm font-medium text-content-muted mb-1.5">Thinking effort</label>
    <select name="skill_effort" id="skill_effort"
            class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
      <% StepsHelper::EFFORT_OPTIONS.each do |label, value| %>
        <option value="<%= value %>" <%= "selected" if cfg["effort"] == value || (cfg["effort"].blank? && value == "medium") %>><%= label %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label for="skill_max_turns" class="block text-sm font-medium text-content-muted mb-1.5">Turn limit</label>
    <input type="number" name="skill_max_turns" id="skill_max_turns"
           value="<%= cfg["max_turns"] %>" min="1" placeholder="No limit"
           class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
  </div>
</div>

<div>
  <label for="skill_allowed_tools" class="block text-sm font-medium text-content-muted mb-1.5">Allowed tools</label>
  <input type="text" name="skill_allowed_tools" id="skill_allowed_tools"
         value="<%= cfg["allowed_tools"] %>" placeholder="<%= StepExecutor::DEFAULT_ALLOWED_TOOLS %>"
         class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent">
  <p class="text-xs text-content-muted mt-1.5">
    Comma separated; anything else is refused. Patterns work, for example
    <code class="bg-surface-input px-1 rounded">Bash(git *)</code>.
    Blank inherits the server's default allowed tools.
  </p>
</div>

<label class="flex items-start gap-3 cursor-pointer">
  <input type="checkbox" name="skill_preview_assets" value="1" <%= "checked" if cfg["preview_assets"] %>
         class="accent-accent h-4 w-4 rounded cursor-pointer mt-0.5">
  <span>
    <span class="block text-sm font-medium text-content">Collect images and other files it produces</span>
    <span class="block text-xs text-content-muted mt-0.5">Charts, screenshots, audio and video show up on the run page instead of only on disk.</span>
  </span>
</label>
