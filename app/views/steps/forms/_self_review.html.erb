<%# Self review: the agent reads its own diff with read-only tools.
    Config keys base_ref and focus are read by StepExecutor. Locals: f:, step: %>
<% cfg = step.config || {} %>
<div class="space-y-4">
  <p class="text-sm text-content-muted">
    Shows the model everything this run has changed so far and asks it to review its own work.
    It can read but not write.
  </p>

  <div>
    <label for="review_base_ref" class="block text-sm font-medium text-content-muted mb-1.5">Compare against</label>
    <input type="text" name="review_base_ref" id="review_base_ref"
           value="<%= cfg["base_ref"] %>" placeholder="main"
           class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent">
    <p class="text-xs text-content-muted mt-1.5">The branch the diff is taken against. Blank works it out from the repository.</p>
  </div>

  <div>
    <label for="review_focus" class="block text-sm font-medium text-content-muted mb-1.5">What to look for</label>
    <textarea name="review_focus" id="review_focus" rows="5"
              placeholder="e.g. Check error handling on the new endpoints and that every branch has a test."
              class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent resize-y"><%= cfg["focus"] %></textarea>
    <p class="text-xs text-content-muted mt-1.5">Blank asks for a general review.</p>
  </div>
</div>
