<%# One disclosure group in the step inspector. Locals: title:, open: %>
<details class="group bg-surface-input/30 border border-edge rounded-lg" <%= "open" if open %>>
  <summary class="list-none cursor-pointer px-4 py-3 text-sm font-semibold text-content flex items-center justify-between">
    <%= title %>
    <span class="text-content-muted text-xs transition-transform group-open:rotate-90" aria-hidden="true">&#9656;</span>
  </summary>
  <div class="px-4 pb-4 space-y-4 border-t border-edge pt-4">
    <%= yield %>
  </div>
</details>
