<%# What the step reads and what it publishes. Locals: f:, step:, claude: %>
<% cfg = claude ? (step.config || {}) : {} %>
<% skill_default_schema = step.skill&.default_json_schema %>
<% skill_default_var = step.skill&.default_output_variable.to_s %>
<% picker_selected_id = cfg["json_schema_id"].to_i %>
<% using_skill_default = skill_default_schema && (cfg["json_schema_id"].blank? || picker_selected_id == skill_default_schema.id) %>
<%# The single "Output variable" input is the canonical produces source whenever
    a schema is set or inherited; both cases hide the multi-tag widget. %>
<% schema_mode = claude && (cfg["json_schema_id"].present? || using_skill_default) %>
<% schema_output_var = schema_mode ? (step.produces.first.presence || skill_default_var) : "" %>

<% if claude %>
  <div data-controller="step-schema-picker" data-step-schema-picker-overridden-value="<%= using_skill_default ? "false" : "true" %>">
    <input type="hidden" name="schema_picker_mode"
           value="<%= using_skill_default ? "inherit" : "override" %>"
           data-step-schema-picker-target="modeInput">
    <label class="block text-sm font-medium text-content-muted mb-1.5">Output shape</label>

    <% if skill_default_schema %>
      <div data-step-schema-picker-target="badge" style="<%= "display:none" unless using_skill_default %>"
           class="flex items-center justify-between gap-3 px-3 py-2 bg-surface-input/60 border border-edge rounded-lg">
        <span class="text-sm text-content truncate">
          Using skill default:
          <span class="font-mono"><%= skill_default_var.presence || "output" %></span>
          <span class="text-content-muted">(<%= skill_default_schema.name %>)</span>
        </span>
        <button type="button" data-action="step-schema-picker#override"
                class="text-xs text-accent font-semibold hover:underline shrink-0 bg-transparent border-none cursor-pointer">Change</button>
      </div>
    <% end %>

    <div data-step-schema-picker-target="picker" style="<%= "display:none" if using_skill_default && skill_default_schema %>" class="space-y-2">
      <select name="json_schema_id" id="json_schema_id"
              data-step-form-target="schemaSelect" data-action="step-form#schemaChanged"
              class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
        <option value="">Free text</option>
        <% JsonSchema.order(:name).each do |schema| %>
          <option value="<%= schema.id %>" <%= "selected" if picker_selected_id == schema.id %>><%= schema.name %></option>
        <% end %>
      </select>
      <% if skill_default_schema %>
        <button type="button" data-action="step-schema-picker#restoreDefault"
                class="text-xs text-content-muted hover:text-accent font-medium bg-transparent border-none cursor-pointer p-0">
          Back to the skill default (<%= skill_default_schema.name %>)
        </button>
      <% end %>
      <p class="text-xs text-content-muted">Picking a schema makes the model answer in that exact shape, so later steps can read individual fields.</p>
    </div>
  </div>
<% end %>

<div data-step-form-target="producesMultiFields" style="<%= "display:none" if schema_mode %>">
  <label class="block text-sm font-medium text-content-muted mb-1.5">Publishes</label>
  <div data-controller="produces-input"
       data-step-form-target="producesInputWrapper"
       data-produces-input-suggestions-url-value="<%= produces_suggestions_project_workflow_steps_path(@project, @workflow) %>"
       data-produces-input-initial-value="<%= schema_mode ? "" : step.produces.join(",") %>">
    <ul data-produces-input-target="tagList" class="flex flex-wrap gap-1 mb-2 min-h-[1.5rem]"></ul>
    <div class="flex gap-1.5">
      <input type="text" data-produces-input-target="newInput"
             list="produces_input_suggestions"
             data-action="keydown->produces-input#keydown input->produces-input#input"
             placeholder="e.g. pr_number, build_status"
             class="flex-1 px-3 py-1.5 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent">
      <button type="button" data-action="produces-input#add"
              class="px-3.5 py-1.5 bg-surface-input border border-edge text-content-muted rounded-lg text-xs font-bold hover:bg-edge hover:text-content transition-all cursor-pointer">Add</button>
    </div>
    <datalist id="produces_input_suggestions" data-produces-input-target="datalist"></datalist>
    <input type="hidden" name="produces" data-produces-input-target="hiddenInput" value="<%= schema_mode ? "" : step.produces.join(",") %>">
  </div>
  <p class="text-xs text-content-muted mt-1.5">Names later steps can read.</p>
  <details class="mt-2">
    <summary class="text-xs text-content-muted cursor-pointer hover:text-content">How outputs work</summary>
    <p class="text-xs text-content-muted mt-1.5 leading-relaxed">
      AI steps write these in <code class="bg-surface-input px-1 rounded">```output</code> blocks; shell steps write them
      with <code class="bg-surface-input px-1 rounded">::set-output</code>.
    </p>
  </details>
</div>

<div data-step-form-target="schemaOutputFields" style="<%= "display:none" unless schema_mode %>">
  <label for="schema_output_variable" class="block text-sm font-medium text-content-muted mb-1.5">Publishes as</label>
  <input type="text" name="schema_output_variable" id="schema_output_variable"
         value="<%= schema_output_var %>" data-step-form-target="schemaOutputInput"
         placeholder="e.g. parse_result"
         class="w-full px-3 py-1.5 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent">
  <p class="text-xs text-content-muted mt-1.5">The whole structured answer is stored under this one name.</p>
</div>

<% available_vars = Step.available_variables_for(@workflow, step.position.to_i) %>
<div>
  <label class="block text-sm font-medium text-content-muted mb-1.5">Reads</label>
  <% if available_vars.any? %>
    <div class="max-h-56 overflow-y-auto bg-surface-input/50 border border-edge rounded-xl">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-surface-input/80 border-b border-edge text-content-muted font-bold text-[10px] uppercase tracking-wider">
            <th class="py-2.5 px-4 text-center w-32">Include value in prompt</th>
            <th class="py-2.5 px-4 text-center w-32"
                title="The step's shell can extract subpaths with the seneschal-context CLI.">Queryable in workspace <span class="font-normal normal-case">(advanced)</span></th>
            <th class="py-2.5 px-4">Variable</th>
            <th class="py-2.5 px-4 text-right">From</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-edge/50">
          <% available_vars.each do |var| %>
            <tr class="hover:bg-surface-input/30 transition-colors">
              <td class="py-2 px-4 text-center">
                <input type="checkbox" name="consumes[]" value="<%= var["name"] %>"
                       <%= "checked" if step.consumes.include?(var["name"]) %>
                       class="accent-accent h-4 w-4 rounded cursor-pointer">
              </td>
              <td class="py-2 px-4 text-center">
                <% if var["queryable"] %>
                  <input type="checkbox" name="queries[]" value="<%= var["name"] %>"
                         <%= "checked" if step.queries.include?(var["name"]) %>
                         class="accent-accent h-4 w-4 rounded cursor-pointer">
                <% else %>
                  <span class="text-content-muted/30">-</span>
                <% end %>
              </td>
              <td class="py-2 px-4 font-mono text-content font-medium"><%= var["name"] %></td>
              <td class="py-2 px-4 text-right text-content-muted font-medium font-mono text-[11px]"><%= var["source"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-content-muted">Nothing to read yet. Earlier steps in this workflow publish variables here.</p>
  <% end %>
</div>

<% if claude %>
  <% other_projects = Project.where.not(id: @project.id).order(:name) %>
  <% selected_ids = (cfg["context_projects"] || []).map(&:to_i) %>
  <div>
    <label for="skill_context_projects" class="block text-sm font-medium text-content-muted mb-1.5">Other projects to read</label>
    <% if other_projects.any? %>
      <select name="skill_context_projects[]" id="skill_context_projects" multiple size="<%= [other_projects.size, 5].min %>"
              class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
        <% other_projects.each do |other| %>
          <option value="<%= other.id %>" <%= "selected" if selected_ids.include?(other.id) %>>
            <%= other.name %><%= " (not cloned)" unless other.repo_ready? %>
          </option>
        <% end %>
      </select>
      <p class="text-xs text-content-muted mt-1.5">Read-only. Hold Cmd or Ctrl to pick more than one. Projects that are not cloned are skipped.</p>
    <% else %>
      <p class="text-sm text-content-muted">No other projects to share.</p>
    <% end %>
  </div>
<% end %>

<div>
  <%= f.label :input_context, "Extra instructions", class: "block text-sm font-medium text-content-muted mb-1.5" %>
  <%= f.text_area :input_context, rows: 4,
        placeholder: "Optional. Anything this step should know that is not in the skill or prompt.",
        class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent resize-y" %>
  <p class="text-xs text-content-muted mt-1.5">
    Appended to an AI step's prompt, or available to a shell step as
    <code class="bg-surface-input px-1 rounded">$INPUT_CONTEXT</code>.
  </p>
</div>
