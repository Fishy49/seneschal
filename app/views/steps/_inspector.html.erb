<%# The step editor, living inside the workflow editor's inspector frame.
    Rendered on its own for a direct visit, and swapped into the frame when a
    step is opened or saved. Locals: project:, workflow:, step: %>
<%= turbo_frame_tag "step_inspector" do %>
  <% skills = Skill.for_project(project).includes(:project).order(:name) %>
  <% templates = step.new_record? ? StepTemplate.includes(skill: :project).ordered : StepTemplate.none %>
  <div data-controller="template-panel skill-panel file-panel"
       data-template-panel-new-step-url-value="<%= new_project_workflow_step_path(project, workflow) %>">
    <%= render layout: "shared/components/card", locals: { class: "step-form-wrapper" } do %>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold"><%= step.new_record? ? "Add step" : "Edit step" %></h2>
        <%= link_to "Close", project_workflow_path(project, workflow),
              data: { turbo_frame: "_top" },
              class: "text-[0.8125rem] text-content-muted hover:text-content transition-colors" %>
      </div>
      <%= render "steps/form", step: step %>
    <% end %>

    <%= render "steps/template_panel", templates: templates if templates.any? %>
    <%= render "steps/skill_panel", skills: skills %>
    <%= render "steps/file_panel", project: project %>
  </div>
<% end %>
