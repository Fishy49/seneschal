<% skills = Skill.for_project(@project).includes(:project).order(:name) %>
<% claude = step.step_type.in?(["skill", "prompt"]) %>
<%# script and command are the same behaviour under two names; the form offers
    one, and an existing script step edits and saves as a shell step. %>
<% partial = step.step_type.in?(["script", "command"]) ? "shell" : step.step_type %>
<% type_url = step.new_record? ? new_project_workflow_step_path(@project, @workflow) : edit_project_workflow_step_path(@project, @workflow, step) %>

<%= form_with model: [@project, @workflow, step],
      data: { controller: "step-form",
              action: "step-schema-picker:changed->step-form#schemaChanged",
              step_form_skills_value: skills.map { |s| [s.id, s.body] }.to_h.to_json } do |f| %>

  <% if step.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg mb-4 text-sm">
      <% step.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <% if step.new_record? && StepTemplate.exists? %>
    <div class="mb-4 pb-4 border-b border-edge flex items-center justify-between">
      <button type="button" data-action="template-panel#open"
              class="inline-flex items-center gap-1.5 px-3 py-2 bg-surface-input border border-edge rounded-lg text-sm text-content-muted hover:text-content hover:bg-edge transition-colors cursor-pointer font-medium">
        Start from a template
      </button>
      <%= link_to "Manage templates", step_templates_path,
            class: "text-xs text-content-muted hover:text-accent transition-colors font-medium" %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-content-muted mb-1.5" %>
      <%= f.text_field :name, placeholder: "e.g. build-assets",
            class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent" %>
    </div>

    <%# Switching type re-fetches the form for the new type, so only that
        type's fields are ever on the page. A saved step with settings warns
        first, because its old config does not survive the switch. %>
    <div data-controller="step-type-switch"
         data-step-type-switch-url-value="<%= type_url %>"
         data-step-type-switch-warn-value="<%= step.persisted? && step.config.present? %>"
         data-step-type-switch-current-value="<%= step.step_type %>">
      <%= f.label :step_type, "Type", class: "block text-sm font-medium text-content-muted mb-1.5" %>
      <%= f.select :step_type, StepsHelper::TYPE_OPTIONS, {},
            class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent",
            data: { step_type_switch_target: "select", action: "step-type-switch#changed" } %>
      <div data-step-type-switch-target="warning" hidden
            class="mt-2 bg-warning/10 border border-warning/40 text-warning px-3 py-2 rounded-lg text-sm flex items-center justify-between gap-3">
        <span data-step-type-switch-target="warningText"></span>
        <button type="button" data-action="step-type-switch#confirm"
                class="shrink-0 px-2.5 py-1 bg-warning text-white rounded-lg text-xs font-medium border-none cursor-pointer hover:opacity-90 transition-opacity">
          Switch anyway
        </button>
      </div>
    </div>

    <%= render "steps/forms/#{partial}", f: f, step: step %>

    <% if claude %>
      <%= render "steps/forms/group", title: "Model and tools", open: false do %>
        <%= render "steps/forms/model_and_tools", step: step %>
      <% end %>
    <% end %>

    <%= render "steps/forms/group", title: "Data", open: step.produces.any? || step.consumes.any? do %>
      <%= render "steps/forms/data", f: f, step: step, claude: claude %>
    <% end %>

    <%= render "steps/forms/group", title: "Guards and recovery", open: false do %>
      <%= render "steps/forms/guards", f: f, step: step %>
    <% end %>

    <%= render "steps/forms/group", title: "Reuse", open: false do %>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" name="save_as_template" value="1" class="accent-accent h-4 w-4 rounded cursor-pointer mt-0.5"
               data-step-form-target="saveTemplateCheck" data-action="step-form#toggleSaveTemplate">
        <span>
          <span class="block text-sm font-medium text-content">Save as a template</span>
          <span class="block text-xs text-content-muted mt-0.5">Keeps this configuration in the Library so any workflow can start from it.</span>
        </span>
      </label>
      <div data-step-form-target="saveTemplateFields" style="display:none" class="mt-3 pl-7 space-y-3">
        <div>
          <label for="template_name" class="block text-xs font-semibold text-content-muted mb-1.5">Template name</label>
          <input type="text" name="template_name" placeholder="e.g. Build assets and push to S3"
                 class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
        </div>
        <div>
          <label for="template_description" class="block text-xs font-semibold text-content-muted mb-1.5">Description</label>
          <input type="text" name="template_description" placeholder="When would somebody reach for this?"
                 class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex gap-3 pt-5 border-t border-edge mt-6">
    <%= f.submit "Save step", class: "inline-flex items-center gap-2 px-5 py-2 bg-accent text-white rounded-lg text-sm font-semibold hover:bg-accent-hover transition-colors cursor-pointer select-none" %>
    <%= link_to "Cancel", project_workflow_path(@project, @workflow), data: { turbo_frame: "_top" },
          class: "inline-flex items-center gap-1.5 px-4 py-2 bg-transparent border border-edge text-content-muted rounded-lg text-sm font-semibold hover:bg-surface-input hover:text-content transition-colors select-none" %>
  </div>
<% end %>
