<%= render layout: "shared/components/page_header", locals: { title: "Tasks" } do %>
  <%= link_to "New Task", new_pipeline_task_path, class: btn_classes(:primary) %>
<% end %>

<%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
  <%= form_with url: pipeline_tasks_path, method: :get, class: "flex items-center gap-3 flex-wrap", data: { turbo_frame: "_top" } do |f| %>
    <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search tasks..."
           class="<%= input_classes("flex-1 min-w-[200px]") %>">
    <select name="project_id" onchange="this.form.requestSubmit()"
            class="<%= input_classes("w-auto!") %>">
      <option value="">All Projects</option>
      <% @projects.each do |p| %>
        <option value="<%= p.id %>" <%= "selected" if params[:project_id].to_s == p.id.to_s %>><%= p.name %></option>
      <% end %>
    </select>
    <select name="status" onchange="this.form.requestSubmit()"
            class="<%= input_classes("w-auto!") %>">
      <option value="">All Statuses</option>
      <% PipelineTask::STATUSES.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s.capitalize %></option>
      <% end %>
    </select>
    <button type="submit" class="<%= btn_classes(:ghost) %>">Search</button>
    <% if params[:q].present? || params[:project_id].present? || params[:status].present? || params[:kind].present? || params[:archived].present? %>
      <%= link_to "Clear", pipeline_tasks_path, class: btn_classes(:quiet, size: :sm) %>
    <% end %>
    <% if @show_archived %>
      <%= link_to "Show Active", pipeline_tasks_path(request.query_parameters.except("archived")), class: btn_classes(:quiet, size: :sm) %>
    <% else %>
      <%= link_to "Show Archived", pipeline_tasks_path(request.query_parameters.merge(archived: "1")), class: btn_classes(:quiet, size: :sm) %>
    <% end %>
  <% end %>
<% end %>

<% if @tasks.any? %>
  <% %w[draft ready running completed failed].each do |status| %>
    <% tasks_in_status = @tasks.select { |t| t.status == status } %>
    <% next if tasks_in_status.empty? %>
    <%= render layout: "shared/components/card", locals: { title: status.capitalize, class: "mb-4" } do %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="<%= th_classes %>">Title</th>
              <th class="<%= th_classes %>">Kind</th>
              <th class="<%= th_classes %>">Project</th>
              <th class="<%= th_classes %>">Workflow</th>
              <th class="<%= th_classes %>">Updated</th>
            </tr>
          </thead>
          <tbody>
            <% tasks_in_status.each do |task| %>
              <tr>
                <td class="<%= td_classes %>"><%= link_to task.title, pipeline_task_path(task) %></td>
                <td class="<%= td_classes %>"><%= type_badge(task.kind) %></td>
                <td class="<%= td_classes("text-content-muted") %>"><%= task.project.name %></td>
                <td class="<%= td_classes("text-content-muted") %>"><%= task.workflow&.name || "-" %></td>
                <td class="<%= td_classes("text-content-muted font-mono") %>"><%= time_ago_short(task.updated_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <% if params[:q].present? || params[:project_id].present? || params[:status].present? %>
      <%= render "shared/components/empty_state", message: "No tasks match your filters.",
            cta_label: "Clear filters", cta_path: pipeline_tasks_path %>
    <% else %>
      <%= render "shared/components/empty_state", message: "No tasks yet.",
            cta_label: "Create your first task", cta_path: new_pipeline_task_path %>
    <% end %>
  <% end %>
<% end %>
