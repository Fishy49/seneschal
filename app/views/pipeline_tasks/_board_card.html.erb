<%# One task on the board. Locals: task:, run: (active run or nil),
    comment_count:, unread:, waiting: (true in the seal column) %>
<div class="bg-surface-card border <%= waiting ? "border-brass/40 shadow-[inset_3px_0_0_var(--brass)]" : "border-edge" %> rounded-lg p-3 flex flex-col gap-1.5 <%= "opacity-70" if task.status.in?(["completed", "failed"]) %>">
  <span class="inline-flex items-center gap-1.5 text-[0.6875rem] font-semibold text-content-muted bg-surface-input rounded px-1.5 py-0.5 w-fit">
    <i class="w-1.5 h-1.5 rounded-[2px] bg-accent inline-block"></i><%= task.project.name %>
  </span>
  <%= link_to task.title, pipeline_task_path(task), class: "text-[0.8125rem] font-semibold leading-snug text-content hover:text-accent transition-colors" %>
  <div class="text-xs text-content-muted truncate">
    <% if run %>
      <%= run.workflow.name %> &middot; run <%= run.ordinal %>
    <% elsif task.workflow %>
      <%= task.workflow.name %> &middot; <%= pluralize(task.workflow.steps.size, "step") %>
    <% else %>
      no workflow yet
    <% end %>
  </div>

  <% if run && !waiting %>
    <% total = run.workflow.steps.size %>
    <% done = run.run_steps.count { |rs| rs.status == "passed" } %>
    <% stats = run.usage_stats %>
    <div class="h-[3px] rounded-full bg-surface-input overflow-hidden">
      <i class="block h-full bg-info rounded-full" style="width: <%= total.positive? ? ((done.to_f / total) * 100).round : 0 %>%"></i>
    </div>
    <div class="font-mono tabular-nums text-[0.6875rem] text-content-muted">
      step <%= [done + 1, total].min %>/<%= total %><% if stats && stats[:cost_usd].to_f.positive? %> &middot; <%= format_cost(stats[:cost_usd]) %><% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-2 mt-0.5">
    <% if waiting && run %>
      <%= button_to "Approve", approve_run_path(run), class: btn_classes(:brass, size: :xs) %>
      <%= link_to "Review", run_path(run), class: btn_classes(:ghost, size: :xs) %>
    <% elsif task.status == "completed" %>
      <span class="<%= chip_tone_classes(:ok) %> px-1.5 py-0.5 rounded text-[0.6875rem] font-semibold">shipped</span>
    <% elsif task.status == "failed" %>
      <span class="<%= chip_tone_classes(:danger) %> px-1.5 py-0.5 rounded text-[0.6875rem] font-semibold">failed</span>
    <% end %>
    <% if comment_count.positive? %>
      <span class="inline-flex items-center gap-1 font-mono text-[0.6875rem] text-content-muted">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.3-.7L3 21l1.8-5.7a8.4 8.4 0 1 1 16.2-3.8z"/></svg><%= comment_count %>
      </span>
    <% end %>
    <% if unread %>
      <span class="w-1.5 h-1.5 rounded-full bg-accent" title="unread activity"></span>
    <% end %>
    <time class="ml-auto font-mono text-[0.6875rem] text-content-faint"><%= time_ago_short(task.updated_at) %></time>
  </div>
</div>
