<%# The launch composer: describe the work, pick where it runs, say when.
    Locals: task: %>
<%= form_with model: task do |f| %>
  <% if task.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg mb-4 text-sm">
      <% task.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-6" data-controller="task-form">
    <div>
      <%= f.label :title, class: label_classes %>
      <%= f.text_field :title, placeholder: "NPC dialogue trees",
            class: input_classes %>
    </div>

    <div>
      <%= f.label :project_id, "Project", class: label_classes %>
      <%= f.select :project_id, Project.order(:name).pluck(:name, :id),
            {}, class: input_classes,
            data: { action: "change->task-form#projectChanged", task_form_target: "projectSelect" } %>
    </div>

    <%= render "pipeline_tasks/workflow_cards", f: f, task: task %>

    <div data-controller="code-editor format-body" data-format-body-url-value="<%= format_task_body_path %>">
      <div class="flex items-center justify-between mb-1.5">
        <span class="block text-sm font-medium text-content-muted">Spec</span>
        <button type="button" data-action="format-body#format" data-format-body-target="btn"
                class="<%= btn_classes(:ghost, size: :sm) %>">
          Format with Claude
        </button>
      </div>
      <div class="codejar-wrap">
        <code class="language-markdown codejar-editor" data-code-editor-target="editor"></code>
      </div>
      <%= f.hidden_field :body, data: { code_editor_target: "input", format_body_target: "input" } %>
    </div>

    <%= render "pipeline_tasks/relevant_files", f: f, task: task %>

    <%= render "trigger_fields", f: f, task: task %>

    <details>
      <summary class="text-sm text-content-muted cursor-pointer select-none hover:text-content">Advanced</summary>
      <div class="mt-3">
        <%= f.label :kind, "Tag", class: label_classes %>
        <%= f.select :kind, PipelineTask::KINDS.map { |k| [k.capitalize, k] },
              {}, class: input_classes("md:w-64") %>
        <p class="<%= hint_classes %>">
          Available to steps as <code class="bg-surface-input px-1 rounded">${task_kind}</code>. Defaults to feature.
        </p>
      </div>
    </details>

    <div class="flex gap-2 pt-2 border-t border-edge">
      <%= button_tag "Launch", type: "submit", name: "run_now", value: "1",
            class: btn_classes(:primary) %>
      <%= f.submit "Save draft", class: btn_classes(:ghost) %>
      <%= link_to "Cancel", (task.persisted? ? pipeline_task_path(task) : pipeline_tasks_path),
            class: btn_classes(:ghost) %>
    </div>
  </div>
<% end %>
