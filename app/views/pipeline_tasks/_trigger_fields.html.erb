<%
  current_cron    = task.cron_expression
  preset_values   = PipelineTask::CRON_PRESETS.map { |p| p[:cron] }
  selected_preset = preset_values.include?(current_cron) ? current_cron : (current_cron.present? ? "custom" : PipelineTask::CRON_PRESETS.first[:cron])
  initial_branch  = task.watched_branch
%>

<div class="mb-4"
     data-controller="trigger-config"
     data-trigger-config-branches-url-value="<%= remote_task_branches_path %>">
  <span class="<%= label_classes %>">When to run</span>
  <div class="flex flex-wrap items-center gap-2">
    <% [["Now, or when I say so", "manual"],
        ["On a schedule", "cron"],
        ["When a branch changes", "github_watch"]].each do |label, value| %>
      <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-edge text-sm cursor-pointer transition-colors hover:bg-surface-input has-[:checked]:bg-accent/15 has-[:checked]:border-accent has-[:checked]:text-accent">
        <%= f.radio_button :trigger_type, value, class: "accent-accent",
              data: { trigger_config_target: "type", action: "change->trigger-config#typeChanged" } %>
        <%= label %>
      </label>
    <% end %>
  </div>

  <div hidden data-trigger-config-target="cronPanel" class="mt-3 p-3 bg-surface-muted rounded-lg border border-edge">
    <label class="<%= label_classes %>">Schedule</label>
    <%= select_tag "pipeline_task[trigger_config][cron_preset]",
          options_for_select(
            PipelineTask::CRON_PRESETS.map { |p| [p[:label], p[:cron]] } + [["Custom...", "custom"]],
            selected_preset
          ),
          class: input_classes,
          data: {
            trigger_config_target: "cronPreset",
            action: "change->trigger-config#presetChanged"
          } %>

    <div hidden data-trigger-config-target="cronCustom" class="mt-2">
      <label class="block text-xs text-content-muted mb-1">Cron expression <span class="font-mono">(min hr dom mon dow)</span></label>
      <%= text_field_tag "pipeline_task[trigger_config][cron]",
            (selected_preset == "custom" ? current_cron : ""),
            placeholder: "0 9 * * 1-5",
            class: input_classes("font-mono") %>
      <p class="<%= hint_classes %>">Timezone: <span class="font-mono"><%= Time.zone.name %></span></p>
    </div>
  </div>

  <div hidden data-trigger-config-target="watchPanel" class="mt-3 p-3 bg-surface-muted rounded-lg border border-edge">
    <label class="<%= label_classes %>">GitHub repo URL</label>
    <div class="flex gap-2 mb-2">
      <%= text_field_tag "pipeline_task[trigger_config][repo_url]",
            task.watched_repo_url,
            placeholder: "git@github.com:owner/repo.git",
            class: input_classes("flex-1"),
            data: { trigger_config_target: "repoUrl" } %>
      <button type="button"
              data-trigger-config-target="loadBranchesBtn"
              data-action="trigger-config#loadBranches"
              class="<%= btn_classes(:ghost, extra: "shrink-0") %>">
        Load Branches
      </button>
    </div>

    <label class="<%= label_classes %>">Branch</label>
    <%= select_tag "pipeline_task[trigger_config][branch]",
          initial_branch.present? ? content_tag(:option, initial_branch, value: initial_branch, selected: true) : nil,
          disabled: initial_branch.blank?,
          class: input_classes("disabled:opacity-50"),
          data: { trigger_config_target: "branch", initial_value: initial_branch } %>

    <p class="<%= hint_classes %>" data-trigger-config-target="branchStatus">
      Uses the host's git auth (SSH keys). Runs fire when the branch HEAD changes.
    </p>
  </div>
</div>
