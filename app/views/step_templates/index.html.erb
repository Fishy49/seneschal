<%= render "shared/library_nav" %>
<%= render "shared/components/page_header", title: "Templates" %>

<%= render layout: "shared/components/card", locals: { title: "Workflow starters", class: "mb-6" } do %>
  <p class="text-sm text-content-muted mb-4">
    Whole workflows that ship with Seneschal. Pick a project and use one as the starting point.
  </p>
  <% if @projects.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <% Seneschal::StarterTemplates.list.each do |template| %>
        <div class="bg-surface-card border border-edge rounded-lg p-5">
          <div class="flex items-start justify-between gap-2 mb-1">
            <h3 class="font-semibold"><%= template.name %></h3>
            <%= render "shared/components/chip", text: template.teaches, tone: :accent %>
          </div>
          <p class="text-sm text-content-muted mb-3"><%= template.description %></p>
          <div class="flex flex-wrap items-center gap-1 mb-3">
            <% template.step_types.each_with_index do |step_type, index| %>
              <% if index.positive? %><span class="text-content-muted text-xs">&rarr;</span><% end %>
              <%= type_badge(step_type) %>
            <% end %>
          </div>
          <%= form_with url: create_from_template_project_workflows_path(@projects.first), method: :post,
                class: "flex items-center gap-2", data: { controller: "template-target" } do %>
            <%= hidden_field_tag :template, template.key %>
            <select data-action="change->template-target#projectChanged"
                    data-template-target-paths-value="<%= @projects.to_h { |p| [p.id, create_from_template_project_workflows_path(p)] }.to_json %>"
                    class="<%= input_classes("flex-1") %>">
              <% @projects.each do |project| %>
                <option value="<%= project.id %>"><%= project.name %></option>
              <% end %>
            </select>
            <button type="submit" class="<%= btn_classes(:primary, size: :sm, extra: "shrink-0") %>">
              Use
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/components/empty_state", message: "Add a project first, then start it from a template.",
          cta_label: "New project", cta_path: new_project_path %>
  <% end %>
<% end %>

<h2 class="text-lg font-semibold mb-1">Step templates</h2>
<p class="text-sm text-content-muted mb-4">
  Single steps captured from workflows that already work. Start a new step from one instead of a blank form.
</p>

<% if @templates.any? %>
  <div data-controller="list-filter">
    <div class="flex items-center gap-3 mb-4">
      <input type="text" placeholder="Search templates..." autocomplete="off"
             data-list-filter-target="search" data-action="input->list-filter#filter"
             class="<%= input_classes("flex-1") %>" />
      <div class="w-44 shrink-0">
        <select data-list-filter-target="type" data-action="change->list-filter#filter"
                class="<%= input_classes %>">
          <option value="">All types</option>
          <% StepsHelper::TYPE_OPTIONS.each do |label, value| %>
            <option value="<%= value %>"><%= label %></option>
          <% end %>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-list-filter-target="list">
      <% @templates.each do |template| %>
        <% searchable = [template.name, template.description, template.step_type,
                         template.skill&.display_name, template.body].compact.join(" ").downcase %>
        <div class="bg-surface-card border border-edge rounded-lg p-5"
             data-type="<%= template.step_type %>" data-searchable="<%= searchable %>">
          <div class="flex items-start justify-between gap-3 mb-1">
            <h2 class="font-semibold">
              <%= link_to template.name, step_template_path(template), class: "hover:text-accent transition-colors" %>
            </h2>
            <%= type_badge(template.step_type) %>
          </div>
          <p class="text-sm text-content-muted mb-2">
            <%= template.description.presence || "No description yet." %>
          </p>
          <div class="text-xs text-content-muted">
            <% if template.skill %>
              Skill: <%= template.skill.display_name %> &middot;
            <% end %>
            <span class="font-mono tabular-nums"><%= template.timeout %>s</span> timeout &middot; <%= pluralize(template.max_retries, "retry") %>
          </div>
          <div class="flex items-center gap-2 mt-3">
            <%= link_to "Edit", edit_step_template_path(template), class: btn_classes(:ghost, size: :sm) %>
            <%= button_to "Delete", step_template_path(template), method: :delete,
                  class: btn_classes(:danger, size: :sm),
                  data: { turbo_confirm: "Delete template '#{template.name}'?" } %>
          </div>
        </div>
      <% end %>
    </div>

    <p data-list-filter-target="empty" class="bg-surface-card border border-edge rounded-lg p-8 text-center text-content-muted text-sm mt-4" style="display:none">
      No templates match your filters.
    </p>
  </div>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No templates yet. Tick \"Save as a template\" while editing a step to capture one." %>
  <% end %>
<% end %>
