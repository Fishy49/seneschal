<%= render "shared/library_nav" %>
<%= render "shared/components/page_header", title: "Edit template" %>

<div class="max-w-2xl">
  <%= render layout: "shared/components/card" do %>
    <%= form_with model: @template, url: step_template_path(@template) do |f| %>
      <% if @template.errors.any? %>
        <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg mb-4 text-sm">
          <% @template.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <p class="text-sm text-content-muted mb-4">
        Only the name and description can change here. The configuration was captured from a step that
        already worked; to change it, apply this template to a step, adjust it there, and save it again.
      </p>

      <div class="mb-4">
        <%= f.label :name, class: "block text-sm font-medium text-content-muted mb-1.5" %>
        <%= f.text_field :name,
              class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent" %>
      </div>

      <div class="mb-4">
        <%= f.label :description, class: "block text-sm font-medium text-content-muted mb-1.5" %>
        <%= f.text_area :description, rows: 3, placeholder: "When would somebody reach for this?",
              class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent resize-y" %>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Save template", class: "inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium cursor-pointer hover:bg-accent-hover transition-colors" %>
        <%= link_to "Cancel", step_template_path(@template),
              class: "inline-flex items-center gap-1.5 px-4 py-2 bg-transparent border border-edge text-content-muted rounded-lg text-sm font-medium hover:bg-surface-input hover:text-content transition-colors" %>
      </div>
    <% end %>
  <% end %>
</div>
