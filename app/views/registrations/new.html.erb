<h2 class="text-xl font-semibold text-center mb-6">Create Admin Account</h2>
<p class="text-sm text-content-muted text-center mb-6">Set up your Seneschal admin account to get started.</p>

<%= form_with model: @user, url: admin_setup_path, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg text-sm">
      <% @user.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :email, class: label_classes %>
    <%= f.email_field :email, autofocus: true, required: true, class: input_classes %>
  </div>

  <div>
    <%= f.label :password, class: label_classes %>
    <%= f.password_field :password, required: true, class: input_classes %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm Password", class: label_classes %>
    <%= f.password_field :password_confirmation, required: true, class: input_classes %>
  </div>

  <button type="submit" class="<%= btn_classes(:primary, extra: "w-full") %>">
    Create Admin Account
  </button>
<% end %>
