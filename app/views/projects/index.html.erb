<%= render layout: "shared/components/page_header", locals: { title: "Projects" } do %>
  <%= link_to "New Project", new_project_path, class: btn_classes(:primary) %>
<% end %>

<% if @project_groups.any? %>
  <div class="mb-4">
    <%= form_with url: projects_path, method: :get, data: { turbo: false } do |f| %>
      <div class="flex items-center gap-3">
        <label class="text-sm text-content-muted">Filter by group:</label>
        <div class="w-56">
          <%= f.select :group_id,
                options_for_select(
                  [["All projects", ""]] +
                  @project_groups.map { |g| [g.name, g.id] } +
                  [["(ungrouped)", "none"]],
                  params[:group_id]
                ),
                {},
                class: input_classes,
                onchange: "this.form.submit()" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @projects.any? %>
  <% @projects.each do |project| %>
    <%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
      <div class="flex items-center justify-between gap-4">
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-semibold">
            <%= link_to project.name, project_path(project), class: "text-content hover:text-accent transition-colors" %>
            <% if project.skip_permissions? %>
              <span class="ml-1 text-danger" title="Danger Mode">&#9888;</span>
            <% end %>
          </h3>
          <% if project.project_group.present? %>
            <p class="text-xs text-content-muted"><%= project.project_group.name %></p>
          <% end %>
          <p class="text-sm text-content-muted truncate"><%= project.repo_url %></p>
          <% if project.description.present? %>
            <p class="text-sm text-content-muted mt-1"><%= project.description %></p>
          <% end %>
          <div class="text-xs text-content-muted mt-2">
            <%= pluralize(project.workflows.count, "workflow") %> &middot; <%= pluralize(project.pipeline_tasks.count, "task") %>
          </div>
        </div>
        <div class="flex flex-col items-end gap-2 shrink-0">
          <% if project.repo_ready? %>
            <%= render "shared/components/chip", text: "Cloned", tone: :ok %>
          <% elsif project.repo_status == "error" %>
            <%= render "shared/components/chip", text: "Clone failed", tone: :danger %>
          <% elsif project.repo_status.in?(["cloning", "refetching"]) %>
            <%= render "shared/components/chip", text: project.repo_status.titleize, tone: :accent %>
          <% else %>
            <%= render "shared/components/chip", text: "Not cloned", tone: :warn %>
          <% end %>
          <div class="flex items-center gap-2">
            <%= link_to "New Task", new_pipeline_task_path(project_id: project.id), class: btn_classes(:primary, size: :sm) %>
            <%= link_to "View", project_path(project), class: btn_classes(:ghost, size: :sm) %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No projects yet. A project is a git repository Seneschal can work in.",
          cta_label: "Add your first project", cta_path: new_project_path %>
  <% end %>
<% end %>
