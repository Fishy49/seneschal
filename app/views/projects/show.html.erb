<%= turbo_stream_from @project %>

<% project_subtitle = capture do %>
  <span class="inline-flex items-center gap-2 flex-wrap">
    <span class="truncate"><%= @project.repo_url %></span>
    <% if @project.repo_ready? %>
      <%= render "shared/components/chip", text: "Cloned", tone: :ok %>
    <% elsif @project.repo_status == "error" %>
      <%= render "shared/components/chip", text: "Clone failed", tone: :danger %>
    <% elsif @project.repo_status.in?(["cloning", "refetching"]) %>
      <%= render "shared/components/chip", text: @project.repo_status.titleize, tone: :accent %>
    <% else %>
      <%= render "shared/components/chip", text: "Not cloned", tone: :warn %>
    <% end %>
    <% if @project.skip_permissions? %>
      <%= render "shared/components/chip", text: "Danger mode", tone: :danger,
            title: "Steps in this project run without permission prompts." %>
    <% end %>
  </span>
<% end %>

<%= render layout: "shared/components/page_header",
      locals: { title: @project.name, subtitle: project_subtitle } do %>
  <details class="relative">
    <summary class="<%= btn_classes(:ghost, size: :sm, extra: "list-none") %>">
      New
    </summary>
    <div class="absolute right-0 mt-1 w-52 bg-surface-card border border-edge rounded-lg shadow-lg z-20 py-1">
      <%= link_to "Workflow", new_project_workflow_path(@project),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
      <%= link_to "Task", new_pipeline_task_path(project_id: @project.id),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
      <%= link_to "Import workflow", new_project_workflow_import_path(@project),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
    </div>
  </details>
  <button type="button"
          data-action="command-palette#openWithProject"
          data-command-palette-project-param="<%= @project.id %>"
          class="<%= btn_classes(:primary) %>">
    Launch
  </button>
<% end %>

<% if params[:onboarding].present? %>
  <div class="bg-accent/10 border border-accent/40 rounded-lg p-4 mb-4">
    <p class="text-sm text-content">
      <strong>Cloning your repository.</strong>
      You can carry on while it finishes. Next: give this project a workflow.
    </p>
    <%= link_to "Start from a template", new_project_workflow_path(@project),
          class: btn_classes(:primary, size: :sm, extra: "mt-3") %>
  </div>
<% end %>

<%= render "projects/tabs", project: @project, section: @section %>
<%= render "projects/section_#{@section}", project: @project %>
