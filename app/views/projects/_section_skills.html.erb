<%= render layout: "shared/components/card",
      locals: { title: "Skills", action: { label: "All skills", path: skills_path } } do %>
  <p class="text-sm text-content-muted mb-3">
    Skills that live in this project's repository. Shared skills are in the Library and are available here too.
  </p>
  <% if @skills.any? %>
    <ul class="list-none">
      <% @skills.each do |skill| %>
        <li class="flex items-start justify-between gap-3 py-[var(--row-y)] border-b border-edge last:border-b-0">
          <div class="min-w-0">
            <div class="font-medium">
              <%= link_to skill.name, skill_path(skill), class: "hover:text-accent transition-colors" %>
            </div>
            <% if skill.description.present? %>
              <p class="text-[0.8125rem] text-content-muted truncate"><%= skill.description %></p>
            <% end %>
          </div>
          <span class="text-xs text-content-muted shrink-0">
            <%= pluralize(@skill_usage.fetch(skill.id, 0), "step") %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/components/empty_state",
          message: "No skills in this project yet.",
          cta_label: "Add one to the Library", cta_path: new_skill_path %>
  <% end %>
<% end %>
