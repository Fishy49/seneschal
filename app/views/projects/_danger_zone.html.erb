<%# Deleting a project clears its Seneschal records only. The git checkout at
    local_path is left on disk for the operator to remove.
    Stays hand-rolled: the card partial bakes in border-edge, and stacking
    border-danger/40 on top would leave the winner to stylesheet order. %>
<div class="bg-surface-card border border-danger/40 rounded-lg p-5">
  <h2 class="text-lg font-semibold text-danger mb-1">Danger zone</h2>
  <p class="text-sm text-content-muted mb-3">
    Deleting this project removes its
    <%= pluralize(project.workflows.size, "workflow") %>,
    <%= pluralize(project.pipeline_tasks.size, "task") %>,
    <%= pluralize(project.skills.size, "project skill") %>
    and every run they produced. The checked-out repository at
    <code class="font-mono text-xs bg-surface-input px-1 py-0.5 rounded"><%= project.local_path %></code>
    stays on disk.
  </p>
  <%= button_to "Delete project", project_path(project), method: :delete,
        class: btn_classes(:danger, size: :sm),
        data: { turbo_confirm: "Delete \"#{project.name}\" and all of its workflows, tasks and runs? The repository on disk is left alone. This cannot be undone." } %>
</div>
