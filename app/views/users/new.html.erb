<div class="max-w-md">
  <%= render "shared/components/page_header", title: "New User",
        subtitle: "Create a user account. They'll receive an invite link to set their password." %>

  <%= form_with model: @user, url: users_path, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg text-sm">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :email, class: label_classes %>
      <%= f.email_field :email, autofocus: true, required: true, class: input_classes %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :admin, class: "rounded border-edge" %>
      <%= f.label :admin, "Admin", class: "text-sm text-content-muted" %>
    </div>

    <button type="submit" class="<%= btn_classes(:primary) %>">
      Create User
    </button>

    <%= link_to "Cancel", users_path, class: btn_classes(:quiet, extra: "ml-1") %>
  <% end %>
</div>
