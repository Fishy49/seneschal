<%= render "shared/admin_nav" %>

<%= render layout: "shared/components/page_header", locals: { title: "Users" } do %>
  <%= link_to "New User", new_user_path, class: btn_classes(:primary) %>
<% end %>

<%= render layout: "shared/components/card" do %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr>
          <th class="<%= th_classes %>">Email</th>
          <th class="<%= th_classes %>">Role</th>
          <th class="<%= th_classes %>">Status</th>
          <th class="<%= th_classes %>">Invite Link</th>
          <th class="<%= th_classes %>"></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="<%= td_classes("text-content") %>"><%= user.email %></td>
            <td class="<%= td_classes %>">
              <% if user.admin? %>
                <%= render "shared/components/chip", text: "Admin", tone: :accent %>
              <% else %>
                <span class="text-content-muted">Member</span>
              <% end %>
            </td>
            <td class="<%= td_classes %>">
              <% if user.invite_pending? %>
                <%= render "shared/components/chip", text: "Invite Pending", tone: :warn %>
              <% else %>
                <%= render "shared/components/chip", text: "Active", tone: :ok %>
              <% end %>
            </td>
            <td class="<%= td_classes %>">
              <% if user.invite_pending? %>
                <div class="flex items-center gap-2" data-controller="clipboard">
                  <input type="text" value="<%= accept_invite_url(user.invite_token) %>" readonly
                         class="w-64 px-2 py-1 bg-surface-input border border-edge rounded text-xs text-content-muted font-mono truncate"
                         data-clipboard-target="source" />
                  <button type="button" data-action="clipboard#copy"
                          class="<%= btn_classes(:ghost, size: :xs) %>">
                    Copy
                  </button>
                  <%= button_to "Reset", reset_invite_user_path(user), method: :post,
                        class: btn_classes(:ghost, size: :xs) %>
                </div>
              <% else %>
                <span class="text-content-faint">·</span>
              <% end %>
            </td>
            <td class="<%= td_classes("text-right") %>">
              <% unless user == current_user %>
                <%= button_to "Delete", user_path(user), method: :delete,
                      data: { turbo_confirm: "Delete #{user.email}?" },
                      class: btn_classes(:quiet, size: :xs, extra: "text-danger hover:text-danger/80") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
