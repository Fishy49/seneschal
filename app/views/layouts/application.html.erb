<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Seneschal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link rel="stylesheet" id="hljs-theme" href="<%= asset_path("highlight-github-dark.css") %>">
    <script src="<%= asset_path("highlight.min.js") %>"></script>
    <script>
      (function() {
        var t = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
        if (t === "light") {
          document.getElementById("hljs-theme").href = "<%= asset_path("highlight-github.css") %>";
        }
      })();
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <%# The palette controller sits on body so a Launch button anywhere on the
      page is inside its scope. %>
  <body data-controller="<%= "command-palette" if current_user %>"
        data-command-palette-options-url-value="<%= quick_launch_options_path %>"
        data-command-palette-launch-url-value="<%= quick_launch_path %>">
    <div class="grid grid-cols-[220px_1fr] min-h-screen">
      <nav class="bg-surface-card border-r border-edge p-6 px-4 flex flex-col gap-2 sticky top-0 h-screen overflow-y-auto">
        <div class="flex items-center gap-2 text-xl font-bold text-content px-2 mb-4">
          <%= image_tag "logo.png", size: 28, class: "rounded-md" %>
          Seneschal
        </div>
        <%= link_to "Home", root_path, class: nav_link_classes(:home) %>
        <%= link_to runs_path,
              class: "flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm transition-colors #{nav_section == :runs ? 'bg-surface-input text-content' : 'text-content-muted hover:bg-surface-input hover:text-content'}" do %>
          <span>Runs</span>
          <% if (needs_you = awaiting_approval_count).positive? %>
            <span class="inline-flex items-center justify-center min-w-5 px-1.5 py-0.5 rounded-full bg-warning text-white text-[0.6875rem] font-semibold"
                  title="<%= pluralize(needs_you, "run") %> awaiting approval"><%= needs_you %></span>
          <% end %>
        <% end %>
        <div data-controller="sidebar-toggle">
          <div class="flex items-center justify-between">
            <%= link_to "Projects", projects_path,
                  class: "flex-1 #{nav_link_classes(:projects)}" %>
            <% if Project.exists? %>
              <button type="button" class="bg-transparent border-none text-content-muted cursor-pointer px-2 py-1 text-xs rounded-lg hover:text-content hover:bg-surface-input" data-action="sidebar-toggle#toggle" data-sidebar-toggle-target="btn">
                <span data-sidebar-toggle-target="icon">&#9656;</span>
              </button>
            <% end %>
          </div>
          <div class="pl-3" data-sidebar-toggle-target="list" style="display:none">
            <% ProjectGroup.ordered.includes(:projects).each do |group| %>
              <% next if group.projects.empty? %>
              <div data-controller="sidebar-toggle"
                   data-sidebar-toggle-storage-key-value="sidebar_group_<%= group.id %>_open"
                   data-sidebar-toggle-default-open-value="true">
                <button type="button"
                        class="w-full flex items-center gap-1.5 px-3 py-1 mt-1 bg-transparent border-none text-[0.75rem] font-semibold text-content-muted uppercase tracking-wide cursor-pointer hover:text-content rounded-lg"
                        data-action="sidebar-toggle#toggle">
                  <span class="text-[0.625rem] leading-none" data-sidebar-toggle-target="icon">▾</span>
                  <span><%= group.name %></span>
                </button>
                <div data-sidebar-toggle-target="list">
                  <% group.projects.order(:name).each do |project| %>
                    <%= link_to project.name, project_path(project),
                          class: "block px-3 py-1 rounded-lg text-[0.8125rem] transition-colors #{(controller_name == 'projects' && params[:id].to_s == project.id.to_s) ? 'text-content' : 'text-content-muted opacity-80 hover:opacity-100 hover:text-content'}" %>
                  <% end %>
                </div>
              </div>
            <% end %>
            <% ungrouped = Project.where(project_group_id: nil).order(:name) %>
            <% if ungrouped.any? %>
              <% if ProjectGroup.exists? %>
                <div data-controller="sidebar-toggle"
                     data-sidebar-toggle-storage-key-value="sidebar_group_ungrouped_open"
                     data-sidebar-toggle-default-open-value="true">
                  <button type="button"
                          class="w-full flex items-center gap-1.5 px-3 py-1 mt-1 bg-transparent border-none text-[0.75rem] font-semibold text-content-muted uppercase tracking-wide cursor-pointer hover:text-content rounded-lg"
                          data-action="sidebar-toggle#toggle">
                    <span class="text-[0.625rem] leading-none" data-sidebar-toggle-target="icon">▾</span>
                    <span>Ungrouped</span>
                  </button>
                  <div data-sidebar-toggle-target="list">
                    <% ungrouped.each do |project| %>
                      <%= link_to project.name, project_path(project),
                            class: "block px-3 py-1 rounded-lg text-[0.8125rem] transition-colors #{(controller_name == 'projects' && params[:id].to_s == project.id.to_s) ? 'text-content' : 'text-content-muted opacity-80 hover:opacity-100 hover:text-content'}" %>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <% ungrouped.each do |project| %>
                  <%= link_to project.name, project_path(project),
                        class: "block px-3 py-1 rounded-lg text-[0.8125rem] transition-colors #{(controller_name == 'projects' && params[:id].to_s == project.id.to_s) ? 'text-content' : 'text-content-muted opacity-80 hover:opacity-100 hover:text-content'}" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
        <%= link_to "Library", skills_path, class: nav_link_classes(:library) %>
        <%= link_to "Activity", activity_path, class: nav_link_classes(:activity) %>
        <% if current_user&.admin? %>
          <div class="border-t border-edge pt-3 mt-2">
            <div class="px-3 pb-1 text-[0.6875rem] font-semibold uppercase tracking-wide text-content-muted">Admin</div>
            <% NavigationHelper::ADMIN_TABS.each do |tab| %>
              <%= link_to tab[:label], send(tab[:path]), class: nav_sublink_classes(tab[:controller]) %>
            <% end %>
          </div>
        <% end %>

        <div class="flex-1"></div>
        <% if current_user %>
          <div class="border-t border-edge pt-3 mt-2 space-y-1">
            <button type="button" data-action="command-palette#open"
                    class="w-full flex items-center justify-between gap-2 px-3 py-2 bg-accent text-white rounded-lg text-sm font-medium border-none cursor-pointer hover:bg-accent-hover transition-colors">
              <span>Launch</span>
              <kbd class="px-1 py-0.5 rounded bg-white/20 font-mono text-[0.6875rem]">&#8984;K</kbd>
            </button>
            <%= link_to account_path,
                  class: "flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-content-muted hover:bg-surface-input hover:text-content transition-colors" do %>
              <%= avatar_for(current_user, size: :xs) %>
              <span class="truncate"><%= current_user.email %></span>
            <% end %>
            <%= button_to "Sign Out", logout_path, method: :delete,
                  class: "block w-full text-left px-3 py-1.5 rounded-lg text-[0.8125rem] text-content-muted hover:bg-surface-input hover:text-content transition-colors bg-transparent border-none cursor-pointer" %>
          </div>
        <% end %>
        <button type="button" class="theme-switch flex items-center justify-center bg-transparent border-none cursor-pointer py-2"
                data-controller="theme-toggle" data-action="theme-toggle#toggle"
                data-theme-toggle-dark-css-value="<%= asset_path("highlight-github-dark.css") %>"
                data-theme-toggle-light-css-value="<%= asset_path("highlight-github.css") %>">
          <span class="theme-switch-track">
            <span class="theme-switch-icon theme-switch-sun">&#9788;</span>
            <span class="theme-switch-thumb" data-theme-toggle-target="thumb"></span>
            <span class="theme-switch-icon theme-switch-moon">&#9790;</span>
          </span>
        </button>
      </nav>

      <main class="p-8 max-w-[1400px] relative">
        <div class="main-watermark" style="background-image: url('<%= image_path('seneschal_bg.png') %>')"></div>
        <div class="relative z-10">
          <% flash.each do |type, message| %>
            <div class="<%= type == 'notice' ? 'bg-success/15 text-success border border-success/25' : 'bg-danger/15 text-danger border border-danger/25' %> px-4 py-3 rounded-lg mb-4 text-sm">
              <%= message %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    </div>
    <% if current_user %>
      <%= render "shared/command_palette" %>
    <% end %>
  </body>
</html>
