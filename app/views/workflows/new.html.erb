<%= render "shared/project_bar", project: @project %>
<%= render "shared/components/page_header", title: "New workflow",
      subtitle: "Start from something that already works, or build one from nothing." %>

<h2 class="text-lg font-semibold mb-3">Start from a template</h2>
<%= render "workflows/starter_gallery", project: @project %>

<h2 class="text-lg font-semibold mt-8 mb-3">Start blank</h2>
<div class="bg-surface-card border border-edge rounded-lg p-5 max-w-2xl">
  <%= render "form", workflow: @workflow %>
</div>

<p class="text-sm text-content-muted mt-4">
  Got a workflow from somewhere else?
  <%= link_to "Import a file", new_project_workflow_import_path(@project), class: "text-accent hover:underline" %>.
</p>
