<%# The step list is the canvas: ordered, draggable, and the way you open a
    step in the inspector. Locals: project:, workflow:, steps: %>
<div id="workflow_steps">
  <%= render layout: "shared/components/card", locals: { title: "Steps" } do %>
    <div class="flex items-center justify-end mb-3">
      <%= link_to "+ Add step", new_project_workflow_step_path(project, workflow),
            data: { turbo_frame: "step_inspector" },
            class: btn_classes(:ghost, size: :sm) %>
    </div>

    <% if steps.any? %>
      <ul class="list-none" data-controller="sortable-steps"
          data-sortable-steps-url-value="<%= reorder_project_workflow_steps_path(project, workflow) %>">
        <% steps.each do |step| %>
          <li class="flex items-start gap-3 py-[var(--row-y)] border-b border-edge last:border-b-0"
              draggable="true" data-step-id="<%= step.id %>"
              data-sortable-steps-target="item"
              data-action="dragstart->sortable-steps#dragstart dragend->sortable-steps#dragend dragover->sortable-steps#dragover dragleave->sortable-steps#dragleave drop->sortable-steps#drop">
            <span class="text-content-muted select-none pt-1.5 cursor-grab" title="Drag to reorder">&#8942;&#8942;</span>
            <span data-position-badge class="w-7 h-7 rounded-full bg-surface-input text-content-muted text-[0.8125rem] font-semibold font-mono flex items-center justify-center shrink-0"><%= step.position %></span>
            <div class="flex-1 min-w-0">
              <% if step.consumes.any? %>
                <div class="flex flex-wrap gap-1 mb-1">
                  <% step.consumes.each do |var| %>
                    <span data-variable="<%= var %>" data-variable-highlight-target="pill"
                          class="inline-block px-1.5 py-0 rounded text-[0.625rem] bg-info/15 text-info font-mono">&larr; <%= var %></span>
                  <% end %>
                </div>
              <% end %>
              <div class="font-medium">
                <%= link_to step.name, edit_project_workflow_step_path(project, workflow, step),
                      data: { turbo_frame: "step_inspector" }, class: "hover:text-accent transition-colors" %>
              </div>
              <div class="text-[0.8125rem] text-content-muted">
                <%= type_badge(step.step_type) %>
                <% if step.max_retries > 0 %>
                  &middot; <span class="font-mono"><%= step.max_retries %></span> retries
                <% end %>
                &middot; <span class="font-mono"><%= step.timeout %>s</span> timeout
              </div>
              <% ctx = Project.where(id: step.context_project_ids).order(:name) %>
              <% if ctx.any? %>
                <div class="flex flex-wrap gap-1 mt-1">
                  <% ctx.each do |p| %>
                    <span class="inline-block px-1.5 py-0 rounded text-[0.625rem] bg-accent/15 text-accent font-mono">+ <%= p.name %></span>
                  <% end %>
                </div>
              <% end %>
              <% if step.produces.any? %>
                <div class="flex flex-wrap gap-1 mt-1">
                  <% step.produces.each do |var| %>
                    <span data-variable="<%= var %>" data-variable-highlight-target="pill"
                          class="inline-block px-1.5 py-0 rounded text-[0.625rem] bg-success/15 text-success font-mono">&rarr; <%= var %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%= button_to "Remove", project_workflow_step_path(project, workflow, step),
                  method: :delete,
                  class: btn_classes(:ghost, size: :sm, extra: "shrink-0"),
                  data: { turbo_confirm: "Remove step '#{step.name}'?" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render "shared/components/empty_state", message: "No steps yet.",
            cta_label: "Add the first step", cta_path: new_project_workflow_step_path(project, workflow) %>
    <% end %>
  <% end %>

  <%= render "workflows/variables_strip", workflow: workflow, steps: steps %>
</div>
