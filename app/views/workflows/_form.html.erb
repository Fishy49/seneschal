<%= form_with model: [@project, workflow] do |f| %>
  <% if workflow.errors.any? %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg mb-4 text-sm">
      <% workflow.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: label_classes %>
    <%= f.text_field :name, placeholder: "classic_feature", class: input_classes %>
  </div>

  <div class="mb-4">
    <%= f.label :description, class: label_classes %>
    <%= f.text_area :description, placeholder: "Build a classic mode feature from spec to PR",
          class: input_classes("resize-y min-h-20") %>
  </div>

  <div class="mb-4">
    <% current_runner = workflow.config.is_a?(Hash) ? workflow.config["runner"].to_s : "" %>
    <% global_default = Runners.default_name %>
    <label for="workflow_runner" class="<%= label_classes %>">Runner</label>
    <select name="workflow[runner]" id="workflow_runner" class="<%= input_classes %>">
      <option value="" <%= "selected" if current_runner.empty? %>>Use global default (currently <code><%= global_default %></code>)</option>
      <option value="claude_cli" <%= "selected" if current_runner == "claude_cli" %>>Claude CLI - current default; shells out to <code>claude -p</code></option>
      <option value="claude_sdk" <%= "selected" if current_runner == "claude_sdk" %>>Claude Agent SDK (Python sidecar) - unlocks structured outputs, hooks, subagents, MCP</option>
    </select>
    <p class="<%= hint_classes %>">
      Applies to every skill/prompt step in this workflow unless overridden via <code>Step.config["runner"]</code>.
      The SDK runner needs <code>bin/setup_sdk_runner</code> to have been run on the host.
    </p>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: btn_classes(:primary) %>
    <%= link_to "Cancel", project_path(@project), class: btn_classes(:ghost) %>
  </div>
<% end %>
