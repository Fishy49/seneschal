<%= render "shared/project_bar", project: @project, workflow: @workflow %>

<%= render layout: "shared/components/page_header",
      locals: { title: @workflow.name, subtitle: @workflow.description.presence } do %>
  <% if @project.repo_ready? %>
    <%= button_to "Run workflow", trigger_project_workflow_path(@project, @workflow),
          class: btn_classes(:primary) %>
  <% else %>
    <%# Clone is what is actually missing, so offer it here rather than a
        disabled button with an explanation in a tooltip. %>
    <span class="text-xs text-content-muted">Clone the repository to run this</span>
    <%= render "projects/repo_status", project: @project %>
  <% end %>
  <details class="relative">
    <summary class="list-none <%= btn_classes(:ghost, size: :sm) %>">
      &#8943;
    </summary>
    <div class="absolute right-0 mt-1 w-56 bg-surface-card border border-edge rounded-lg shadow-lg z-20 py-1">
      <%= link_to "Edit name and description", edit_project_workflow_path(@project, @workflow),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
      <%= link_to "Copy to project", new_project_workflow_copy_path(@project, @workflow),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
      <%= link_to "Export", export_project_workflow_path(@project, @workflow),
            class: "block px-3 py-2 text-sm text-content-muted hover:bg-surface-input hover:text-content transition-colors" %>
      <%= button_to "Delete", project_workflow_path(@project, @workflow), method: :delete,
            class: "block w-full text-left px-3 py-2 text-sm text-content-muted bg-transparent border-none cursor-pointer hover:bg-surface-input hover:text-danger transition-colors",
            data: { turbo_confirm: "Delete \"#{@workflow.name}\"? Its #{pluralize(@workflow.steps.size, "step")} and #{pluralize(@workflow.runs.size, "run")} go with it. Skills and schemas it uses are not affected." } %>
    </div>
  </details>
<% end %>

<div class="-mt-2 mb-4">
  <p class="text-xs text-content-muted flex items-center gap-1.5">
    <% if @workflow.created_by %>
      <%= avatar_for(@workflow.created_by, size: :xs) %>
      <span>Added by <%= @workflow.created_by.email %></span>
    <% end %>
    <% if @workflow.copied_from %>
      <span>Copied from <%= @workflow.copied_from %></span>
    <% end %>
  </p>
  <div class="flex items-center gap-2 mt-2 flex-wrap">
    <%= render "shared/components/chip", text: "Engine: #{workflow_engine_label(@workflow)}", tone: :neutral %>
    <% @access.each do |chip| %>
      <%= render "shared/components/chip", text: chip.label, tone: chip.tone, title: chip.title %>
    <% end %>
    <% if (line = workflow_stats_line(@stats)) %>
      <span class="text-xs text-content-muted"><%= line %></span>
    <% else %>
      <span class="text-xs text-content-muted">Never run</span>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="variable-highlight">
  <div>
    <%= render "workflows/steps_canvas", project: @project, workflow: @workflow, steps: @steps %>

    <%= render layout: "shared/components/card", locals: { title: "Recent runs", class: "mb-4" } do %>
      <%= render "shared/runs_list", runs: @recent_runs,
            empty_message: "This workflow has not run yet." %>
    <% end %>
  </div>

  <div>
    <%= turbo_frame_tag "step_inspector" do %>
      <%= render layout: "shared/components/card" do %>
        <%= render "shared/components/empty_state", message: "Select a step to edit it.",
              cta_label: "Add a step", cta_path: new_project_workflow_step_path(@project, @workflow) %>
      <% end %>
    <% end %>
  </div>
</div>
