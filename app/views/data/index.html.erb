<%= render "shared/admin_nav" %>

<%= render "shared/components/page_header", title: "Data Management" %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%# Export section %>
  <%= render layout: "shared/components/card", locals: { title: "Export" } do %>
    <p class="text-sm text-content-muted mb-4">
      Download all projects, workflows, steps, skills, tasks, and step templates as a JSON file.
      Runs and user accounts are not included.
    </p>

    <div class="text-sm text-content-muted mb-4 space-y-1">
      <p><span class="font-mono tabular-nums"><%= @project_count %></span> projects, <span class="font-mono tabular-nums"><%= @workflow_count %></span> workflows</p>
      <p><span class="font-mono tabular-nums"><%= @skill_count %></span> skills, <span class="font-mono tabular-nums"><%= @template_count %></span> step templates</p>
      <p><span class="font-mono tabular-nums"><%= @task_count %></span> tasks</p>
    </div>

    <%= link_to "Download Export", data_export_path, class: btn_classes(:primary) %>
  <% end %>

  <%# Import section %>
  <%= render layout: "shared/components/card", locals: { title: "Import" } do %>
    <div class="bg-danger/15 text-danger border border-danger/25 px-4 py-3 rounded-lg text-sm mb-4">
      <p class="font-semibold mb-1">Destructive operation</p>
      <p>Importing will <strong>permanently delete</strong> all existing projects, workflows, steps, runs, tasks, skills, and step templates before loading the imported data.</p>
      <p class="mt-1">User accounts and settings are not affected.</p>
    </div>

    <%= form_with url: data_import_path, multipart: true, class: "space-y-4" do |f| %>
      <div>
        <label class="<%= label_classes %>">Export file (.json)</label>
        <input type="file" name="file" accept=".json"
               class="<%= input_classes("file:mr-3 file:rounded-lg file:border-0 file:bg-accent/15 file:text-accent file:text-xs file:px-3 file:py-1 file:cursor-pointer") %>" />
      </div>

      <button type="submit"
              data-turbo-confirm="This will DELETE all existing projects, workflows, steps, runs, tasks, skills, and step templates. This cannot be undone. Continue?"
              class="<%= btn_classes(:danger) %>">
        Import &amp; Replace All Data
      </button>
    <% end %>
  <% end %>
</div>
