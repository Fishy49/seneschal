<%# Page title row.
    Locals:
      title:    heading text
      subtitle: optional muted line under the title
    Render with `render layout:` to supply right-aligned actions. %>
<div class="flex items-start justify-between gap-4 mb-4">
  <div>
    <h1 class="text-2xl font-semibold"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="text-sm text-content-muted mt-1"><%= subtitle %></p>
    <% end %>
  </div>
  <% if block_given? %>
    <div class="flex items-center gap-2 shrink-0"><%= yield %></div>
  <% end %>
</div>
