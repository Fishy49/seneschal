<%# Tabs for the admin-only pages. Setup is reachable during first boot, so
    this renders nothing for anyone who cannot use the other tabs. %>
<% if current_user&.admin? %>
  <div class="flex items-center gap-1 border-b border-edge mb-6">
    <% NavigationHelper::ADMIN_TABS.each do |tab| %>
      <%= link_to tab[:label], send(tab[:path]), class: nav_tab_classes(controller_name == tab[:controller]) %>
    <% end %>
  </div>
<% end %>
