<%# The Cmd/Ctrl+K launch bar. Rendered once per page from the layout; hidden
    until the controller opens it. The controller itself lives on <body> so
    Launch buttons elsewhere on the page can target it. %>
<div>
  <div data-command-palette-target="overlay" hidden
       class="fixed inset-0 z-50 bg-black/60 flex items-start justify-center pt-[12vh] px-4"
       data-action="click->command-palette#backdropClick">
    <div class="w-full max-w-2xl bg-surface-card border border-edge rounded-lg shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-edge">
        <span class="text-sm font-semibold">Launch a run</span>
        <span class="text-xs text-content-muted">Esc to close &middot; <%= "⌘" %>/Ctrl+Enter to launch</span>
      </div>

      <div class="p-5 space-y-4">
        <div>
          <label for="quick_launch_description" class="block text-sm font-medium text-content-muted mb-1.5">What should Claude do?</label>
          <textarea id="quick_launch_description" rows="4"
                    data-command-palette-target="description"
                    data-action="keydown->command-palette#descriptionKeydown input->command-palette#updateComposerLink"
                    placeholder="Add rate limiting to the public API endpoints"
                    class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent resize-y"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="quick_launch_project" class="block text-sm font-medium text-content-muted mb-1.5">Project</label>
            <select id="quick_launch_project"
                    data-command-palette-target="project"
                    data-action="change->command-palette#projectChanged"
                    class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent"></select>
          </div>
          <div>
            <label for="quick_launch_workflow" class="block text-sm font-medium text-content-muted mb-1.5">Workflow</label>
            <select id="quick_launch_workflow"
                    data-command-palette-target="workflow"
                    data-action="change->command-palette#workflowChanged"
                    class="w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent"></select>
          </div>
        </div>

        <p data-command-palette-target="summary" hidden class="text-xs text-content-muted"></p>

        <p data-command-palette-target="error" hidden
           class="bg-danger/15 text-danger border border-danger/25 px-3 py-2 rounded-lg text-sm"></p>

        <div class="flex items-center gap-2">
          <button type="button" data-action="command-palette#launch"
                  data-command-palette-target="submit"
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium cursor-pointer hover:bg-accent-hover transition-colors">Launch</button>
          <button type="button" data-action="command-palette#close"
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-transparent border border-edge text-content-muted rounded-lg text-sm font-medium cursor-pointer hover:bg-surface-input hover:text-content transition-colors">Cancel</button>
          <a data-command-palette-target="composer" href="<%= new_pipeline_task_path %>"
             class="ml-auto text-sm text-content-muted hover:text-content transition-colors">Full composer</a>
        </div>
      </div>
    </div>
  </div>
</div>
