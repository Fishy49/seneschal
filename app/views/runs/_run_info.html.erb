<%# Broadcast contract: ExecuteRunJob replaces #run_info wholesale, so the
    element id, partial path and `run:` local stay put. The header owns the
    run's identity, status and totals now; this card keeps only what has no
    other home - the error, provenance, and the precise timestamps. %>
<div class="bg-surface-card border border-edge rounded-lg p-4 mb-4" id="run_info">
  <% if run.error_message.present? %>
    <div class="mb-3 px-3 py-2.5 bg-danger/10 border border-danger/30 rounded-lg">
      <p class="text-[0.6875rem] font-semibold uppercase tracking-wide text-danger mb-1">Error</p>
      <p class="text-[0.8125rem] font-mono break-words max-h-40 overflow-y-auto"><%= run.error_message %></p>
    </div>
  <% end %>

  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-xs">
    <% if run.input["resumed_from_run"].present? %>
      <dt class="text-content-muted">Resumed from</dt>
      <dd><%= link_to "Run ##{run.input['resumed_from_run']}", run_path(run.input["resumed_from_run"]) %></dd>
    <% end %>
    <% if run.waiting_for_tokens? && run.waiting_until.present? %>
      <dt class="text-content-muted">Tokens reset</dt>
      <dd><%= run.waiting_until.strftime("%H:%M:%S") %> (<%= time_ago_in_words(run.waiting_until) %> from now)</dd>
    <% end %>
    <dt class="text-content-muted">Started</dt>
    <dd class="font-mono tabular-nums"><%= run.started_at&.strftime("%Y-%m-%d %H:%M:%S") || "-" %></dd>
    <dt class="text-content-muted">Finished</dt>
    <dd class="font-mono tabular-nums"><%= run.finished_at&.strftime("%Y-%m-%d %H:%M:%S") || "-" %></dd>
  </dl>
</div>
