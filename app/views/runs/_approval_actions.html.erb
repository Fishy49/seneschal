<div class="bg-brass/10 border border-brass/30 rounded-lg p-4 mb-4" data-controller="approval-form">
  <div class="flex items-center justify-between gap-3 mb-2">
    <div class="flex items-start gap-2">
      <span class="text-brass mt-0.5"><%= seal_mark(size: 18) %></span>
      <div>
        <p class="font-medium text-sm">Awaiting Approval</p>
        <p class="text-xs text-content-muted">Step: <%= run_step&.step&.name %></p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= form_with url: approve_run_path(run), method: :post, class: "flex items-center gap-2" do |f| %>
        <div class="w-56 shrink-0">
          <%= f.text_field :comment, placeholder: "Optional note...", class: input_classes %>
        </div>
        <%= f.button type: "submit", class: btn_classes(:brass, size: :sm) do %>
          <%= seal_mark(size: 14) %>Approve
        <% end %>
      <% end %>
      <button type="button" data-action="approval-form#toggleReject"
              class="<%= btn_classes(:ghost, size: :sm) %>">
        Reject
      </button>
    </div>
  </div>
  <div data-approval-form-target="rejectForm" style="display:none">
    <%= form_with url: reject_run_path(run), method: :post do |f| %>
      <%= f.text_area :rejection_context, rows: 4,
            placeholder: "Add context the step should use on the next run...",
            class: input_classes("font-mono resize-y mb-2") %>
      <%= f.submit "Reject and Re-run", class: btn_classes(:danger, size: :sm) %>
    <% end %>
  </div>
  <% if run_step %>
    <%= render "runs/approval_history", run_step: run_step %>
  <% end %>
</div>
