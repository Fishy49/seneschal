<%# Broadcast contract: ExecuteRunJob replaces #run_steps_list wholesale, so
    the ul id stays. The ::before pseudo draws the timeline's connector line;
    node circles are position: relative so they paint on top of it. %>
<ul class="list-none relative before:content-[''] before:absolute before:left-[13px] before:top-3 before:bottom-3 before:w-px before:bg-edge" id="run_steps_list">
  <% parent_steps = run.run_steps.includes(:step, :child_run_steps).where(parent_run_step_id: nil).order(Arel.sql("CASE WHEN run_steps.status = 'queued' THEN 1 ELSE 0 END"), :id) %>
  <% parent_steps.each do |run_step| %>
    <%= render "runs/run_step", run_step: run_step, run: run %>
    <% run_step.child_run_steps.order(:id).each do |child| %>
      <%= render "runs/run_step", run_step: child, run: run, nested: true %>
    <% end %>
  <% end %>
  <%# Show remaining workflow steps not yet executed %>
  <% executed_step_ids = run.run_steps.pluck(:step_id) %>
  <% run.workflow.steps.reject { |s| executed_step_ids.include?(s.id) }.each do |step| %>
    <li class="flex items-start gap-3 py-2.5" id="pending_step_<%= step.id %>">
      <span class="relative w-7 h-7 rounded-full bg-surface border border-dashed border-edge text-content-muted text-[0.8125rem] font-semibold flex items-center justify-center shrink-0 mt-0.5" title="not started"><%= step.position %></span>
      <div class="flex-1 min-w-0 pt-1">
        <div class="flex items-center gap-2">
          <span class="font-medium text-sm text-content-muted"><%= step.name %></span>
          <%= type_badge(step.step_type) %>
        </div>
      </div>
    </li>
  <% end %>
</ul>
