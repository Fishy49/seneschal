<%# Identity and actions for a run. ExecuteRunJob broadcasts a replace of
    #run_header with this partial, so the element id, the partial path and the
    `run:` local are a contract - anything live must live in here, and
    anything with a Stimulus subscription must not (it would be torn down on
    every step update). %>
<div id="run_header">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold flex items-center gap-2 flex-wrap">
        <%= run_display_name(run) %>
        <%= status_badge(run.status) %>
        <% if run.workflow.project.skip_permissions? %>
          <span class="bg-danger/15 text-danger border border-danger/25 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide"
                title="This run executed without permission prompts.">&#9888; Danger mode</span>
        <% end %>
      </h1>
      <p class="text-xs text-content-muted mt-1">
        <%
          stats = run.usage_stats
          tokens = stats && (stats[:input_tokens] + stats[:output_tokens] +
                             stats[:cache_read_tokens] + stats[:cache_creation_tokens])
          meta = ["Started by #{run.started_by_label}"]
          meta << time_ago_short(run.started_at || run.created_at)
          meta << format_cost(stats[:cost_usd]) if stats && stats[:cost_usd].to_f.positive?
          meta << "#{format_tokens(tokens)} tokens" if tokens&.positive?
          meta << "stopped by #{run.stopped_by.email}" if run.stopped_by
        %>
        <%= meta.compact.join(" · ") %>
        &middot;
        <%= link_to run.workflow.project.name, project_path(run.workflow.project), class: "hover:text-content transition-colors" %>
        &middot;
        <%= link_to run.workflow.name, project_workflow_path(run.workflow.project, run.workflow), class: "hover:text-content transition-colors" %>
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <% if run.active? %>
        <%= button_to "Stop", stop_run_path(run),
              class: btn_classes(:danger, size: :sm),
              data: { turbo_confirm: "Stop this run?" } %>
      <% end %>
      <% if run.status.in?(["completed", "failed", "stopped"]) && run.pipeline_task&.executable? %>
        <%= button_to "Re-run", execute_pipeline_task_path(run.pipeline_task),
              class: btn_classes(:primary, size: :sm) %>
      <% end %>
      <% if run.status.in?(["failed", "stopped"]) && run.run_steps.exists?(status: "failed") %>
        <%= button_to "Resume", resume_run_path(run),
              class: btn_classes(:primary, size: :sm) %>
      <% end %>
      <%= link_to "Share", run_path(run, anchor: "share"),
            class: btn_classes(:ghost, size: :sm) %>
    </div>
  </div>

  <% if run.awaiting_approval? %>
    <div class="mt-4">
      <%= render "runs/approval_actions", run: run, run_step: run.awaiting_run_step %>
    </div>
  <% end %>

  <% if run.status.in?(["completed", "failed", "stopped"]) %>
    <%= render "runs/follow_up", run: run %>
  <% end %>
</div>
