<%# Append more work to a finished run. Locals: run: %>
<% project_skills = Skill.for_project(run.workflow.project).includes(:project).order(:name) %>
<details class="mt-4" data-controller="follow-up-form">
  <summary class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] font-medium cursor-pointer hover:bg-surface-input hover:text-content transition-colors list-none [&::-webkit-details-marker]:hidden">
    Follow up
  </summary>
  <div class="bg-surface-card border border-edge rounded-lg p-5 mt-3">
    <p class="text-sm text-content-muted mb-3">
      Describe what to fix or change. It runs as a new step appended to this run, with the same context
      (branch, pull request, and so on). You can queue skills to run afterwards.
    </p>
    <%= form_with url: follow_up_run_path(run), method: :post, class: "space-y-4" do |f| %>
      <div>
        <label for="follow_up_instructions" class="block text-sm font-medium text-content-muted mb-1.5">Instructions</label>
        <%= f.text_area :instructions, id: "follow_up_instructions", rows: 5,
              placeholder: "e.g. RunService and StepService still call the database directly. Move them onto the repository, keeping the existing public method signatures.",
              class: "w-full px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm font-mono focus:outline-none focus:border-accent resize-y" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-content-muted mb-1.5">Then run these skills, in order</label>
        <div data-follow-up-form-target="skillList" class="space-y-2"></div>
        <template data-follow-up-form-target="template">
          <div class="flex items-center gap-2">
            <select name="skill_ids[]"
                    class="flex-1 px-3 py-2 bg-surface-input border border-edge rounded-lg text-content text-sm focus:outline-none focus:border-accent">
              <option value="">Select a skill...</option>
              <% project_skills.each do |skill| %>
                <option value="<%= skill.id %>"><%= skill.display_name %></option>
              <% end %>
            </select>
            <button type="button" data-action="follow-up-form#removeSkill"
                    class="px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] cursor-pointer hover:bg-surface-input hover:text-content transition-colors">Remove</button>
          </div>
        </template>
        <button type="button" data-action="follow-up-form#addSkill"
                class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] font-medium cursor-pointer hover:bg-surface-input hover:text-content transition-colors">
          + Add skill
        </button>
      </div>

      <%= f.submit "Start follow up",
            class: "inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium cursor-pointer hover:bg-accent-hover transition-colors" %>
    <% end %>
  </div>
</details>
