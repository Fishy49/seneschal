<%# Append-only decision log for one step, newest first. %>
<% events = run_step.approval_events.recent %>
<% if events.any? %>
  <ul class="list-none mt-2 space-y-1">
    <% events.each do |event| %>
      <li class="text-xs text-content-muted">
        <% if event.action == "approved" %>
          <span class="inline-flex items-center gap-1 text-brass font-medium"><%= seal_mark(size: 11) %><%= event.action.capitalize %></span>
        <% else %>
          <span class="text-danger font-medium"><%= event.action.capitalize %></span>
        <% end %>
        by <%= event.actor_label %> at <span class="font-mono tabular-nums"><%= event.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        <% if event.comment.present? %>
          <div class="mt-0.5 pl-2 border-l border-edge text-content whitespace-pre-wrap"><%= event.comment %></div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
