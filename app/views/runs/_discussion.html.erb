<%# The run's whole story in one place: comments, run-level events, and seal
    decisions interleaved chronologically. Step rows link here instead of
    hosting their own threads. New items broadcast-append into
    #run_discussion, and the empty-state hint hides itself via :empty the
    moment the first one lands, so keep the ul free of whitespace text nodes.

    Locals: run: %>
<% step_options = run.run_steps.includes(:step).order(:id).map do |rs|
     label = rs.position.to_i.positive? ? "Step #{rs.position} · #{rs.step.name}" : rs.step.name
     [label, "RunStep:#{rs.id}"]
   end %>
<% items = run.thread_items %>
<% participants = items.grep(Comment).map(&:user).compact.uniq.first(4) %>
<div class="bg-surface-card border border-edge rounded-lg p-5 mb-4 scroll-mt-4" id="discussion">
  <div class="flex items-center justify-between gap-2 mb-3">
    <h2 class="text-lg font-semibold">Thread</h2>
    <% if participants.any? %>
      <div class="flex -space-x-1.5">
        <% participants.each do |user| %>
          <%= avatar_for(user, size: :sm) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="max-h-[55vh] overflow-y-auto" data-controller="autoscroll">
    <ul class="list-none peer" id="run_discussion"><% items.each do |item| %><%= render_thread_item(item) %><% end %></ul>
    <p class="hidden peer-empty:block text-sm text-content-muted py-1">
      Nothing yet. The run's story - progress, decisions, comments - lands here.
    </p>
  </div>

  <%= form_with url: comments_path, method: :post, class: "mt-3 pt-3 border-t border-edge/60",
        data: { action: "turbo:submit-end->discussion#submitEnd" } do |f| %>
    <div class="flex items-start gap-2.5">
      <%= avatar_for(current_user, size: :sm) %>
      <div class="flex-1 min-w-0">
        <%= text_area_tag "comment[body]", nil, rows: 2, required: true,
              placeholder: "Add a comment. Use @name to notify someone.",
              data: { discussion_target: "body" },
              class: input_classes("resize-y") %>
        <div class="flex items-center justify-between gap-2 mt-1.5">
          <label class="flex items-center gap-1.5 text-xs text-content-muted min-w-0">
            on
            <%= select_tag :commentable,
                  options_for_select([["This run", "Run:#{run.id}"]] + step_options),
                  data: { discussion_target: "select" },
                  class: "max-w-48 truncate px-2 py-1 bg-surface-input border border-edge rounded-lg text-content text-xs focus:outline-none focus:border-accent" %>
          </label>
          <%= f.submit "Comment",
                class: btn_classes(:primary, size: :sm, extra: "shrink-0") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
