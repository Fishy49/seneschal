<%= turbo_stream_from @run %>
<%= render "shared/project_bar",
     project: @run.workflow.project,
     workflow: @run.workflow,
     task: @run.pipeline_task,
     run: @run %>

<%= render "runs/run_chrome", run: @run, mode: :overview %>

<%# data-controller="discussion" sits up here so a step row in the left column
    can reach the composer in the right one ("Comment on this step"). %>
<div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-4" data-controller="discussion">
  <div class="min-w-0">
    <div class="bg-surface-card border border-edge rounded-lg p-5 mb-4" data-controller="preserve-details">
      <div class="flex items-baseline justify-between gap-2 mb-3">
        <h2 class="text-lg font-semibold">Steps</h2>
        <% if (current_step = run_progress_text(@run)) %>
          <span class="text-xs text-content-muted truncate">now: <%= current_step %></span>
        <% end %>
      </div>
      <%= render "run_steps_list", run: @run %>
    </div>
  </div>

  <div class="min-w-0">
    <%= render "run_info", run: @run %>

    <%= render "discussion", run: @run %>

    <%= render "share_links", run: @run %>

    <%# Context and input are reference material once a run is under way, so
        they start closed rather than pushing the discussion off the screen. %>
    <details class="mb-4">
      <summary class="bg-surface-card border border-edge rounded-lg px-5 py-3 text-lg font-semibold cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:text-accent transition-colors">
        Context
      </summary>
      <div class="mt-2">
        <%= render "run_context", run: @run %>
      </div>
    </details>

    <% if @run.input.present? && @run.input.any? %>
      <details class="mb-4">
        <summary class="bg-surface-card border border-edge rounded-lg px-5 py-3 text-lg font-semibold cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:text-accent transition-colors">
          Input
        </summary>
        <div class="bg-surface-card border border-edge rounded-lg p-5 mt-2">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <% @run.input.each do |key, value| %>
                <tr>
                  <th class="<%= th_classes %>"><%= key %></th>
                  <td class="<%= td_classes %>"><code class="font-mono text-[0.8125rem] break-all"><%= value %></code></td>
                </tr>
              <% end %>
            </table>
          </div>
        </div>
      </details>
    <% end %>
  </div>
</div>
