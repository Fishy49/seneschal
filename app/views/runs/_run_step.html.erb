<%# One step in the run timeline. ExecuteRunJob broadcasts a replace of
    #run_step_<id> with this partial, so the outer element id and the partial
    path are a contract. The reading order is deliberate: the row says what
    happened, opening it shows the result, and everything raw is one more
    disclosure down. Discussion lives in the unified feed on the run page;
    the row only carries a count and a way to start a comment there.

    Locals: run_step:, run:, nested: (optional) %>
<% nested = local_assigns.fetch(:nested, false) %>
<% streaming = run_step.status.in?(["running", "retrying"]) %>
<% step_cost = format_cost(run_step.usage_stats&.dig(:cost_usd)) %>
<% comment_count = run_step.comments.size %>
<% output_vars = run_step.step.produces.filter_map { |k| [k, run.context[k]] if run.context[k].present? } %>
<li class="flex items-start gap-3 py-2.5 <%= "ml-9 border-l border-edge pl-3" if nested %>" id="run_step_<%= run_step.id %>">
  <% if nested %>
    <span class="relative w-5 h-5 rounded-full <%= step_node_classes(run_step.status) %> text-[0.625rem] font-semibold flex items-center justify-center shrink-0 mt-0.5" title="<%= run_step.status.tr("_", " ") %>">&hookrightarrow;</span>
  <% else %>
    <span class="relative w-7 h-7 rounded-full <%= step_node_classes(run_step.status) %> text-[0.8125rem] font-semibold flex items-center justify-center shrink-0 mt-0.5" title="<%= run_step.status.tr("_", " ") %>"><%= run_step.position.to_i.positive? ? run_step.position : "&middot;".html_safe %></span>
  <% end %>

  <div class="flex-1 min-w-0">
    <details class="group/step" data-preserve-key="step" <%= "open" if streaming || run_step.status == "awaiting_approval" %>>
      <summary class="cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden rounded-lg -mx-1.5 px-1.5 py-0.5 hover:bg-surface-input/40 transition-colors">
        <div class="flex items-center gap-2 min-w-0">
          <svg viewBox="0 0 12 12" fill="currentColor" class="w-2.5 h-2.5 shrink-0 text-content-muted transition-transform group-open/step:rotate-90"><path d="M4 2l5 4-5 4z"/></svg>
          <span class="font-medium text-sm truncate"><%= run_step.step.name %></span>
          <%= type_badge(run_step.step.step_type) %>
          <% if comment_count.positive? %>
            <span class="inline-flex items-center gap-1 text-xs text-content-muted shrink-0" title="<%= pluralize(comment_count, "comment") %> in the discussion">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3 h-3"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v6a1.5 1.5 0 0 1-1.5 1.5H8.5L5 14v-3H3.5A1.5 1.5 0 0 1 2 9.5z"/></svg><%= comment_count %>
            </span>
          <% end %>
          <span class="ml-auto flex items-center gap-2.5 shrink-0 text-xs text-content-muted tabular-nums">
            <% if run_step.attempt > 1 %>
              <span class="text-warning">attempt <%= run_step.attempt %></span>
            <% end %>
            <% if step_cost %><span><%= step_cost %></span><% end %>
            <% if run_step.duration %><span><%= format_duration(run_step.duration) %></span><% end %>
          </span>
        </div>
        <% if (result = run_step_result_line(run_step, output_vars)) %>
          <p class="text-xs text-content-muted mt-0.5 truncate pl-[1.125rem]"><%= result %></p>
        <% end %>
      </summary>

      <div class="mt-2 pl-[1.125rem]">
        <% if run_step.step.step_type == "ci_check" && streaming %>
          <%= render "runs/ci_check_status", run_step: run_step %>
        <% end %>

        <% if output_vars.any? %>
          <div class="mb-2">
            <p class="text-[0.8125rem] text-success mb-1">Produced</p>
            <% output_vars.each do |key, value| %>
              <details class="ml-2" data-preserve-key="out-<%= key %>">
                <summary class="text-xs font-semibold text-success cursor-pointer select-none hover:text-success/80"><%= key %></summary>
                <div class="output-block mt-1 mb-1 text-xs"><%= value %></div>
              </details>
            <% end %>
          </div>
        <% end %>

        <% if run_step.status == "failed" && run_step.error_output.present? %>
          <div class="mb-2">
            <p class="text-[0.8125rem] text-danger mb-1">Error</p>
            <div class="output-block text-xs" style="border-color:var(--danger)"><%= run_step.error_output %></div>
          </div>
        <% end %>

        <%# The awaiting step already shows its history inside the approval panel. %>
        <% unless run_step.status == "awaiting_approval" %>
          <%= render "runs/approval_history", run_step: run_step %>
        <% end %>

        <details class="mt-2" data-preserve-key="raw" <%= "open" if streaming %>>
          <summary class="text-[0.8125rem] text-content-muted cursor-pointer select-none hover:text-content">Raw details</summary>
          <div class="mt-1">
            <%= render "runs/run_step_raw", run_step: run_step, run: run, nested: nested, streaming: streaming %>
          </div>
        </details>

        <div class="mt-2 flex items-center gap-4">
          <button type="button"
                  data-action="discussion#composeFor"
                  data-discussion-value-param="RunStep:<%= run_step.id %>"
                  class="text-[0.8125rem] text-content-muted hover:text-accent bg-transparent border-none cursor-pointer p-0 transition-colors">
            Comment on this step
          </button>
          <% if run.status.in?(["failed", "stopped"]) && run_step.status == "failed" %>
            <%= button_to "Retry from here",
                  retry_from_run_path(run, step_id: run_step.step_id),
                  class: "inline-flex items-center gap-1.5 px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] font-medium cursor-pointer hover:bg-surface-input hover:text-content transition-colors" %>
          <% end %>
        </div>
      </div>
    </details>
  </div>
</li>
