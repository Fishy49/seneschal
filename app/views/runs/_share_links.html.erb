<%# Collapsed like Context and Input: sharing is an occasional action, not
    something to spend a whole card on. The header's Share link jumps to
    #share, which is why the id lives on the details element. %>
<% links = run.share_links.recent %>
<details class="mb-4 scroll-mt-4" id="share">
  <summary class="bg-surface-card border border-edge rounded-lg px-5 py-3 text-lg font-semibold cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:text-accent transition-colors">
    Share<% if links.any? %> <span class="text-xs font-medium text-content-muted align-middle">(<%= links.size %>)</span><% end %>
  </summary>
  <div class="bg-surface-card border border-edge rounded-lg p-5 mt-2">
    <% if links.any? %>
      <ul class="list-none mb-3">
        <% links.each do |link| %>
          <li class="flex items-center justify-between gap-2 py-[var(--row-y)] border-b border-edge/60 last:border-b-0">
            <div class="min-w-0">
              <div class="text-xs font-mono truncate"><%= shared_run_url(link.token) %></div>
              <div class="text-xs text-content-muted">
                <% if link.expired? %>
                  expired <%= time_ago_short(link.expires_at) %>
                <% else %>
                  expires <%= link.expires_at.strftime("%Y-%m-%d") %>
                <% end %>
                <% if link.created_by %>&middot; by <%= link.created_by.email %><% end %>
              </div>
            </div>
            <%= button_to "Revoke", share_link_path(link), method: :delete,
                  class: btn_classes(:danger, size: :xs, extra: "shrink-0"),
                  data: { turbo_confirm: "Revoke this share link?" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-content-muted mb-3">A link gives read-only access to a redacted summary: task, project, workflow, step names and statuses, timings and total cost. No logs, no output, no paths.</p>
    <% end %>
    <%= button_to "Create link", share_links_path(run_id: run.id),
          class: btn_classes(:ghost, size: :sm) %>
  </div>
</details>
