<%= render "shared/components/page_header", title: "Runs" %>

<%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
  <%= form_with url: runs_path, method: :get, class: "flex items-center gap-3 flex-wrap", data: { turbo_frame: "_top" } do |f| %>
    <select name="project_id" onchange="this.form.requestSubmit()"
            class="<%= input_classes("w-auto!") %>">
      <option value="">All Projects</option>
      <% @projects.each do |p| %>
        <option value="<%= p.id %>" <%= "selected" if params[:project_id].to_s == p.id.to_s %>><%= p.name %></option>
      <% end %>
    </select>
    <select name="status" onchange="this.form.requestSubmit()"
            class="<%= input_classes("w-auto!") %>">
      <option value="">All Statuses</option>
      <% Run::STATUSES.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s.capitalize %></option>
      <% end %>
    </select>
    <% if params[:project_id].present? || params[:status].present? %>
      <%= link_to "Clear", runs_path, class: btn_classes(:quiet, size: :sm) %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/components/card" do %>
  <% filtered = params[:project_id].present? || params[:status].present? %>
  <% if filtered %>
    <%= render "shared/runs_list", runs: @runs,
          empty_message: "No runs match your filters.",
          empty_cta_label: "Clear filters", empty_cta_path: runs_path %>
  <% else %>
    <%= render "shared/runs_list", runs: @runs,
          empty_message: "No runs yet.",
          empty_cta_label: "Launch your first run", empty_cta_action: "command-palette#open" %>
  <% end %>
<% end %>
