<div class="max-w-2xl mx-auto">
  <%= render "shared/admin_nav" %>
  <%= render "shared/components/page_header", title: "Health checks",
        subtitle: "Seneschal drives these tools on the host machine. Install and sign in to each one, then check it here." %>

  <%= render "shared/health_checks", claude: @claude, gh: @gh, sdk_runner: @sdk_runner %>

  <% if @all_ok %>
    <div class="mt-6 text-center">
      <%# A fresh install has nothing to look at yet, so send the operator to
          the one thing they need next. %>
      <% if Project.none? %>
        <%= link_to "Add your first project", new_project_path(onboarding: 1),
              class: btn_classes(:primary) %>
      <% else %>
        <%= link_to "Continue to Home", root_path, class: btn_classes(:primary) %>
      <% end %>
    </div>
  <% end %>
</div>
