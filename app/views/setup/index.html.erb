<div class="max-w-2xl mx-auto">
  <%= render "shared/admin_nav" %>
  <h1 class="text-2xl font-bold mb-2">Health checks</h1>
  <p class="text-sm text-content-muted mb-6">
    Seneschal drives these tools on the host machine. Install and sign in to each one, then check it here.
  </p>

  <%= render "shared/health_checks", claude: @claude, gh: @gh, sdk_runner: @sdk_runner %>

  <% if @all_ok %>
    <div class="mt-6 text-center">
      <%= link_to "Continue to Dashboard", root_path,
            class: "inline-block px-6 py-2.5 bg-accent text-white rounded-lg text-sm font-semibold hover:bg-accent-hover transition-colors" %>
    </div>
  <% end %>
</div>
