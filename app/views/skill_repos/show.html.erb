<%= render layout: "shared/components/page_header",
      locals: { title: @skill_repo.name, subtitle: "Skill Repo" } do %>
  <%= button_to "Sync now", sync_skill_repo_path(@skill_repo), class: btn_classes(:ghost, size: :sm) %>
  <%= link_to "Edit", edit_skill_repo_path(@skill_repo), class: btn_classes(:ghost, size: :sm) %>
  <%= button_to "Remove", skill_repo_path(@skill_repo), method: :delete,
        class: btn_classes(:danger, size: :sm),
        data: { turbo_confirm: "Remove '#{@skill_repo.name}'? This deletes its cloned directory and its Skill records." } %>
<% end %>

<%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
  <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3 text-sm">
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Repo URL</dt>
      <dd><code class="text-xs font-mono"><%= @skill_repo.repo_url %></code></dd>
    </div>
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Branch</dt>
      <dd><code class="text-xs font-mono"><%= @skill_repo.branch %></code></dd>
    </div>
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Local path</dt>
      <dd><code class="text-xs font-mono"><%= @skill_repo.local_path %></code></dd>
    </div>
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Priority</dt>
      <dd class="font-mono tabular-nums"><%= @skill_repo.priority %> <span class="text-content-muted text-xs font-sans">(lower = earlier)</span></dd>
    </div>
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Status</dt>
      <dd>
        <% if @skill_repo.enabled? %>
          <%= render "shared/components/chip", text: "enabled", tone: :accent %>
        <% else %>
          <%= render "shared/components/chip", text: "disabled", tone: :neutral %>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-content-muted text-xs uppercase tracking-wide mb-1">Last sync</dt>
      <dd>
        <% if @skill_repo.last_synced_at %>
          <span class="font-mono tabular-nums"><%= @skill_repo.last_synced_at.strftime("%Y-%m-%d %H:%M") %></span>
          <span class="text-content-muted">(<%= time_ago_in_words(@skill_repo.last_synced_at) %> ago)</span>
        <% else %>
          <span class="text-content-muted">never</span>
        <% end %>
      </dd>
    </div>
  </dl>
<% end %>

<% if @skill_repo.last_sync_error.present? %>
  <div class="bg-danger/10 border border-danger/30 rounded-lg p-5 mb-4">
    <h2 class="text-sm font-semibold text-danger mb-2">Last sync error</h2>
    <pre class="text-xs font-mono whitespace-pre-wrap"><%= @skill_repo.last_sync_error %></pre>
  </div>
<% end %>

<%= render layout: "shared/components/card",
      locals: { title: "Skills (#{@active_skills.size})", class: "mb-4" } do %>
  <% if @active_skills.any? %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="<%= th_classes %>">Name</th>
            <th class="<%= th_classes %>">Description</th>
            <th class="<%= th_classes %>">Install notes</th>
          </tr>
        </thead>
        <tbody>
          <% @active_skills.each do |skill| %>
            <tr>
              <td class="<%= td_classes %>"><%= link_to skill.name, skill_path(skill) %></td>
              <td class="<%= td_classes("text-content-muted") %>"><%= truncate(skill.description, length: 100) %></td>
              <td class="<%= td_classes %>">
                <% if @skill_repo.install_notes_for(skill.name).present? %>
                  <%= render "shared/components/chip", text: "setup required", tone: :warn %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-content-muted text-sm">No skills yet - try running a sync.</p>
  <% end %>
<% end %>

<% notes_hash = @skill_repo.install_notes.is_a?(Hash) ? @skill_repo.install_notes : {} %>
<% if notes_hash.any? %>
  <%= render layout: "shared/components/card", locals: { title: "Install notes", class: "mb-4" } do %>
    <p class="text-sm text-content-muted mb-3">
      Captured from each skill's <code>.install-notes</code> file. These are setup steps
      (env vars, MCP servers, dependencies) that need to be in place before the skill
      will work end-to-end.
    </p>
    <% notes_hash.each do |skill_name, body| %>
      <details class="border border-edge rounded-lg mb-2">
        <summary class="px-3 py-[var(--row-y)] cursor-pointer text-sm font-medium hover:bg-surface-input">
          <%= skill_name %>
        </summary>
        <pre class="px-3 py-2 text-xs font-mono whitespace-pre-wrap border-t border-edge bg-surface-input/30"><%= body %></pre>
      </details>
    <% end %>
  <% end %>
<% end %>

<% if @archived_skills.any? %>
  <%= render layout: "shared/components/card",
        locals: { title: "Archived skills (#{@archived_skills.size})", class: "mb-4" } do %>
    <p class="text-sm text-content-muted mb-3">
      Removed from the repo upstream. Step references are preserved so workflows
      can show "this skill is no longer available" rather than silently breaking.
      Re-adding the skill upstream un-archives it on next sync.
    </p>
    <ul class="text-sm">
      <% @archived_skills.each do |skill| %>
        <li class="py-[var(--row-y)] text-content-muted">
          <%= link_to skill.name, skill_path(skill) %>
          <span class="text-xs">· archived <%= time_ago_in_words(skill.archived_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
