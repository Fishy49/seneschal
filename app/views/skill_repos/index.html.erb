<%= render "shared/library_nav" %>

<% index_subtitle = capture do %>
  External git repositories that ship agentskills.io <code>SKILL.md</code> folders.
  Synced every 6 hours, or on demand.
<% end %>
<%= render layout: "shared/components/page_header",
      locals: { title: "Skill Repos", subtitle: index_subtitle } do %>
  <%= link_to "Add Repo", new_skill_repo_path, class: btn_classes(:primary) %>
<% end %>

<% if @skill_repos.any? %>
  <%= render layout: "shared/components/card", locals: { class: "mb-4" } do %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="<%= th_classes %>">Name</th>
            <th class="<%= th_classes %>">Repo</th>
            <th class="<%= th_classes %>">Branch</th>
            <th class="<%= th_classes %>">Status</th>
            <th class="<%= th_classes("text-right") %>">Skills</th>
            <th class="<%= th_classes %>">Last sync</th>
            <th class="<%= th_classes("text-right") %>">Pri</th>
            <th class="<%= th_classes %>"></th>
          </tr>
        </thead>
        <tbody>
          <% @skill_repos.each do |repo| %>
            <tr>
              <td class="<%= td_classes %>">
                <%= link_to repo.name, skill_repo_path(repo), class: "font-medium" %>
              </td>
              <td class="<%= td_classes("text-content-muted") %>">
                <code class="text-xs font-mono"><%= truncate(repo.repo_url, length: 50) %></code>
              </td>
              <td class="<%= td_classes("text-content-muted") %>"><%= repo.branch %></td>
              <td class="<%= td_classes %>">
                <% if repo.last_sync_error.present? %>
                  <%= render "shared/components/chip", text: "error", tone: :danger %>
                <% elsif !repo.enabled? %>
                  <%= render "shared/components/chip", text: "disabled", tone: :neutral %>
                <% elsif repo.last_synced_at.nil? %>
                  <%= render "shared/components/chip", text: "never synced", tone: :neutral %>
                <% else %>
                  <%= render "shared/components/chip", text: "enabled", tone: :accent %>
                <% end %>
              </td>
              <td class="<%= td_classes("text-right font-mono tabular-nums") %>"><%= @skill_counts[repo.id] || 0 %></td>
              <td class="<%= td_classes("text-content-muted") %>">
                <%= repo.last_synced_at ? "#{time_ago_in_words(repo.last_synced_at)} ago" : "·" %>
              </td>
              <td class="<%= td_classes("text-right font-mono tabular-nums") %>"><%= repo.priority %></td>
              <td class="<%= td_classes("text-right") %>">
                <%= button_to "Sync", sync_skill_repo_path(repo), class: btn_classes(:ghost, size: :xs) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <%= render layout: "shared/components/card" do %>
    <%= render "shared/components/empty_state",
          message: "No skill repos registered. Point one at a git repo containing agentskills.io SKILL.md folders.",
          cta_label: "Add your first one", cta_path: new_skill_repo_path %>
  <% end %>
<% end %>
