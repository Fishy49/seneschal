<h2 class="text-xl font-semibold text-center mb-6">Sign In</h2>

<%= form_with url: login_path, class: "space-y-4" do |f| %>
  <div>
    <label for="email" class="<%= label_classes %>">Email</label>
    <input type="email" name="email" id="email" autofocus required class="<%= input_classes %>" />
  </div>

  <div>
    <label for="password" class="<%= label_classes %>">Password</label>
    <input type="password" name="password" id="password" required class="<%= input_classes %>" />
  </div>

  <button type="submit" class="<%= btn_classes(:primary, extra: "w-full") %>">
    Sign In
  </button>
<% end %>
