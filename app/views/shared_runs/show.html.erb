<%# PURPOSE-BUILT redacted view. Do not render any runs/ partial here.
    ALLOWED: task title, project name, workflow name, run status, per-step
    names / statuses / durations, total cost, started and finished times.
    FORBIDDEN: stream logs, tool calls, file contents, error output, worktree
    or repo paths, environment, context variables, comments, approval notes. %>
<div class="max-w-3xl mx-auto p-8">
  <div class="mb-6">
    <p class="text-xs uppercase tracking-wide text-content-muted mb-1">Shared run summary</p>
    <h1 class="text-2xl font-semibold">
      <%= @run.pipeline_task&.title || "Manual run" %>
      <%= status_badge(@run.status) %>
    </h1>
    <p class="text-sm text-content-muted mt-1">
      <%= @run.workflow.project.name %> &middot; <%= @run.workflow.name %>
    </p>
  </div>

  <div class="bg-surface-card border border-edge rounded-lg p-5 mb-4">
    <table class="w-full border-collapse">
      <tr>
        <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Started</th>
        <td class="px-3 py-2 border-b border-edge text-sm"><%= @run.started_at&.strftime("%Y-%m-%d %H:%M") || "not started" %></td>
      </tr>
      <tr>
        <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Finished</th>
        <td class="px-3 py-2 border-b border-edge text-sm"><%= @run.finished_at&.strftime("%Y-%m-%d %H:%M") || "still running" %></td>
      </tr>
      <tr>
        <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Duration</th>
        <td class="px-3 py-2 border-b border-edge text-sm"><%= format_duration(@run.duration) %></td>
      </tr>
      <% if (stats = @run.usage_stats) && stats[:cost_usd].to_f > 0 %>
        <tr>
          <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Total cost</th>
          <td class="px-3 py-2 border-b border-edge text-sm"><%= format_cost(stats[:cost_usd]) %></td>
        </tr>
      <% end %>
    </table>
  </div>

  <div class="bg-surface-card border border-edge rounded-lg p-5">
    <h2 class="text-lg font-semibold mb-3">Steps</h2>
    <% if @run_steps.any? %>
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Step</th>
            <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Status</th>
            <th class="text-left px-3 py-2 border-b border-edge text-xs font-semibold uppercase tracking-wide text-content-muted">Duration</th>
          </tr>
        </thead>
        <tbody>
          <% @run_steps.each do |run_step| %>
            <tr>
              <td class="px-3 py-2 border-b border-edge text-sm"><%= run_step.step&.name || "(removed step)" %></td>
              <td class="px-3 py-2 border-b border-edge"><%= status_badge(run_step.status) %></td>
              <td class="px-3 py-2 border-b border-edge text-sm text-content-muted"><%= format_duration(run_step.duration) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center py-8 text-content-muted">No steps recorded.</p>
    <% end %>
  </div>

  <p class="text-xs text-content-muted mt-6 text-center">
    Read-only summary shared from Seneschal. Link expires <%= @share_link.expires_at.strftime("%Y-%m-%d") %>.
  </p>
</div>
