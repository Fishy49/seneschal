<%= render layout: "shared/components/page_header", locals: { title: "Home" } do %>
  <button type="button" data-action="command-palette#open"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium border-none cursor-pointer hover:bg-accent-hover transition-colors">
    Launch
  </button>
<% end %>

<div data-controller="dashboard-refresh">
  <div id="dashboard_awaiting" data-dashboard-refresh-target="region">
    <%= render "dashboard/awaiting_runs", runs: @awaiting_runs, viewers: @awaiting_viewers %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= render layout: "shared/components/card",
            locals: { title: "Runs", action: { label: "View all", path: runs_path }, class: "mb-4" } do %>
        <div id="dashboard_active" data-dashboard-refresh-target="region">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-content-muted mb-1">Active</h3>
          <% if @active_runs.any? %>
            <ul class="list-none mb-4">
              <%= render partial: "dashboard/run_row", collection: @active_runs, as: :run %>
            </ul>
          <% else %>
            <p class="text-sm text-content-muted py-3 mb-2">Nothing running right now.</p>
          <% end %>
        </div>

        <h3 class="text-xs font-semibold uppercase tracking-wide text-content-muted mb-1">Recent</h3>
        <% if @recent_runs.any? %>
          <ul class="list-none">
            <%= render partial: "dashboard/run_row", collection: @recent_runs, as: :run %>
          </ul>
        <% else %>
          <%= render "shared/components/empty_state", message: "No runs yet.",
                cta_label: "Launch your first run", cta_action: "command-palette#open" %>
        <% end %>
      <% end %>
    </div>

    <div>
      <%= render layout: "shared/components/card",
            locals: { title: "Projects", action: { label: "New project", path: new_project_path }, class: "mb-4" } do %>
        <% if @projects.any? %>
          <ul class="list-none">
            <% @projects.each do |project| %>
              <li class="flex items-center justify-between gap-3 py-2 border-b border-edge last:border-b-0">
                <div class="min-w-0">
                  <div class="truncate">
                    <%= link_to project.name, project_path(project), class: "font-medium hover:text-accent transition-colors" %>
                    <% unless project.repo_ready? %>
                      <span class="ml-1 text-xs text-content-muted"><%= project.repo_status.tr("_", " ") %></span>
                    <% end %>
                  </div>
                  <div class="text-xs text-content-muted">
                    <%= pluralize(project.workflows.count, "workflow") %> &middot;
                    <%= pluralize(project.pipeline_tasks.count, "task") %>
                  </div>
                </div>
                <button type="button"
                        data-action="command-palette#openWithProject"
                        data-command-palette-project-param="<%= project.id %>"
                        class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] font-medium cursor-pointer hover:bg-surface-input hover:text-content transition-colors">
                  Launch
                </button>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= render "shared/components/empty_state", message: "No projects yet.",
                cta_label: "Create your first project", cta_path: new_project_path %>
        <% end %>
      <% end %>

      <%= render layout: "shared/components/card",
            locals: { title: "Recent activity", action: { label: "View all", path: activity_path }, class: "mb-4" } do %>
        <div id="dashboard_activity" data-dashboard-refresh-target="region">
          <% if @recent_events.any? %>
            <ul class="list-none">
              <%= render partial: "activity/event", collection: @recent_events %>
            </ul>
          <% else %>
            <%= render "shared/components/empty_state", message: "Nothing has happened yet." %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
