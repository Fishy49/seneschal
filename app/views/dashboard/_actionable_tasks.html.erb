<%# Draft and ready tasks, launchable without leaving the dashboard. %>
<% if tasks.any? %>
  <ul class="list-none">
    <% tasks.each do |task| %>
      <li class="flex items-center justify-between gap-3 py-2 border-b border-edge last:border-b-0">
        <div class="min-w-0">
          <div class="truncate">
            <%= link_to task.title, pipeline_task_path(task), class: "font-medium" %>
            <%= status_badge(task.status) %>
          </div>
          <div class="text-xs text-content-muted truncate">
            <%= task.project.name %> &middot; <%= task.workflow&.name || "No workflow assigned" %>
          </div>
        </div>
        <% if task.executable? %>
          <%= button_to "Run", execute_pipeline_task_path(task),
                class: "shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 bg-success text-white rounded-lg text-[0.8125rem] font-medium cursor-pointer hover:bg-success/80 transition-colors" %>
        <% else %>
          <%= link_to "Edit", edit_pipeline_task_path(task),
                class: "shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 bg-transparent border border-edge text-content-muted rounded-lg text-[0.8125rem] font-medium hover:bg-surface-input hover:text-content transition-colors" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-center py-8 text-content-muted">Nothing queued up</p>
<% end %>
